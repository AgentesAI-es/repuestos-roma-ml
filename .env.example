# --- API Mercado Libre (preguntas) ---
ML_API_URL=https://ml-repuestosroma.agentesai.es
ML_API_TOKEN=cambia-esto-por-el-API_BEARER_TOKEN
# Opcional: cuenta ML por defecto (si hay varias conexiones)
ML_CONNECTION_ID=

# --- API de repuestos (respuestas del agente, human in the loop) ---
REPUESTOS_API_URL=https://api-repuestosroma.agentesai.es
# La API_KEY de la API de repuestos (se manda en x-api-key)
REPUESTOS_API_TOKEN=
# true = estados de agente simulados para previsualizar la interfaz
AGENT_MOCK=false

# --- Acceso desde Chatwoot (sección custom del sidebar). Dejar vacío para desactivar ---
CHATWOOT_URL=https://chat-repuestosroma.agentesai.es
CHATWOOT_ACCOUNT_ID=3
# Firma de la cookie de sesión (ej.: openssl rand -hex 32). Vacío = las sesiones se pierden al reiniciar
SESSION_SECRET=

# --- Acceso directo al panel (Basic Auth). Dejar vacío para desactivar ---
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=cambia-esto

# --- Docker ---
APP_PORT=4321
