---
import AgentBadge from './AgentBadge.astro';
import { REVISION_LABEL } from '../lib/agent-responses';
import { formatDate, formatPrice, timeAgo, ML_STATUS_LABEL } from '../lib/format';
import type { AgentResponse, AgentStatus, QuestionListItem } from '../lib/types';

interface Props {
  question: QuestionListItem;
  agentStatus: AgentStatus;
  agent?: AgentResponse;
  connectionId?: number;
  /** La URL de la lista, para que "Aprobar" vuelva acá. */
  returnTo: string;
}

const { question: q, agentStatus, agent, connectionId, returnTo } = Astro.props;
const pub = q.publication;
const detailHref = `/preguntas/${q.id}${connectionId ? `?connection=${connectionId}` : ''}`;
const answered = q.status === 'ANSWERED';
const pending = agentStatus === 'pendiente' && agent?.status === 'pendiente';
---

<article class="card q">
  <div class="thumb">
    {pub?.thumbnail ? <img src={pub.thumbnail} alt="" loading="lazy" /> : <span aria-hidden="true">📦</span>}
  </div>

  <div class="body">
    <div class="meta">
      <span class:list={['ml-status', { answered }]}>{ML_STATUS_LABEL[q.status] ?? q.status}</span>
      <span class="muted" title={formatDate(q.date_created)}>{timeAgo(q.date_created)}</span>
      {q.from?.nickname && <span class="muted">{q.from.nickname}</span>}
    </div>

    {/* El link cubre toda la card (::after). La bandeja lo abre en un modal; Ctrl+clic, en otra pestaña. */}
    <a href={detailHref} class="text" data-detalle>{q.text}</a>

    {
      pub && (
        <div class="pub muted">
          {pub.permalink ? (
            <a href={pub.permalink} target="_blank" rel="noopener">{pub.title ?? pub.item_id}</a>
          ) : (
            <span>{pub.title ?? q.item_id}</span>
          )}
          {pub.price != null && <span> · {formatPrice(pub.price, pub.currency_id)}</span>}
        </div>
      )
    }

    {pending ? (
      <p class="reply proposed full"><span class="reply-label">Propuesta del agente</span>{agent.respuestaPropuesta}</p>
    ) : q.answer?.text ? (
      <p class="reply"><span class="reply-label">Respuesta publicada</span>{q.answer.text}</p>
    ) : agent ? (
      <p class:list={['reply', 'proposed', agent.status]}>
        <span class="reply-label">Respuesta del agente ({REVISION_LABEL[agent.status]})</span>{agent.respuestaEnviada ?? agent.respuestaPropuesta}
      </p>
    ) : null}
  </div>

  <div class="side">
    <AgentBadge status={agentStatus} />
    {
      pending && (
        <form method="post" action="/api/revision" class="approve">
          <input type="hidden" name="id" value={agent!.id} />
          <input type="hidden" name="question_id" value={q.id} />
          {connectionId && <input type="hidden" name="connection" value={connectionId} />}
          <input type="hidden" name="volver" value={returnTo} />
          <button type="submit" class="btn btn-sm btn-primary" data-loading="Aprobando…" title="Aprueba la propuesta del agente tal cual">
            ✓ Aprobar
          </button>
        </form>
      )
    }
  </div>
</article>

<style>
  .q {
    position: relative;
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr) auto;
    gap: 18px;
    padding: 17px 20px;
    align-items: center;
    transition: border-color .15s ease, box-shadow .15s ease;
  }
  .q:hover .text { color: var(--link); }
  .q:hover { border-color: #c7d3df; box-shadow: 0 10px 28px rgb(18 39 60 / .07); }
  .thumb {
    width: 72px;
    height: 72px;
    border-radius: 10px;
    background: var(--surface-2);
    display: grid;
    place-items: center;
    overflow: hidden;
    font-size: 24px;
  }
  .thumb img { width: 100%; height: 100%; object-fit: contain; background-color: #fff; }
  .body { min-width: 0; }
  .meta { display: flex; flex-wrap: wrap; gap: 8px 12px; font-size: 12px; align-items: center; }
  .ml-status {
    font-weight: 600;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--revision);
  }
  .ml-status.answered { color: var(--si); }
  .text {
    display: block;
    margin: 5px 0;
    color: var(--text);
    font-size: 16px;
    font-weight: 680;
    line-height: 1.4;
    overflow-wrap: anywhere;
    text-decoration: none !important;
  }
  .text::after { content: ''; position: absolute; inset: 0; border-radius: inherit; }
  .text:focus-visible { outline: none; }
  .q:has(.text:focus-visible) { outline: 2px solid var(--link); outline-offset: 2px; }
  /* Lo que tiene acción propia queda por encima del link de la card. */
  .pub a, .approve { position: relative; z-index: 1; }
  .pub { font-size: 12px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .pub a { color: inherit; }
  .reply {
    margin: 10px 0 0;
    padding: 8px 11px;
    border-left: 2px solid var(--si);
    background: var(--surface-2);
    border-radius: 0 7px 7px 0;
    font-size: 12px;
    line-height: 1.4;
    max-height: 52px;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow-wrap: anywhere;
  }
  .reply.proposed { border-left-color: var(--revision); }
  /* La propuesta pendiente entera: se puede aprobar desde acá, que se lea todo. */
  .reply.full { max-height: none; display: block; font-size: 13px; }
  .reply.proposed.aprobado { border-left-color: var(--si); }
  .reply.proposed.editado { border-left-color: var(--si); }
  .reply-label { font-weight: 750; color: var(--text-muted); margin-right: 8px; }
  .side { display: flex; flex-direction: column; align-items: flex-end; gap: 12px; min-width: 150px; }
  .approve { margin: 0; }

  @media (max-width: 640px) {
    .q { grid-template-columns: 54px 1fr; gap: 10px 12px; padding: 14px; }
    .thumb { width: 54px; height: 54px; align-self: start; }
    .side { grid-column: 2; flex-direction: row; justify-content: space-between; align-items: center; min-width: 0; width: 100%; }
    .reply { display: none; }
    .reply.full { display: block; }
    .pub { white-space: normal; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  }
</style>
