---
import AgentBadge from './AgentBadge.astro';
import { REVISION_LABEL } from '../lib/agent-responses';
import { formatDate, formatPrice, timeAgo, ML_STATUS_LABEL } from '../lib/format';
import type { AgentResponse, AgentStatus, QuestionListItem } from '../lib/types';

interface Props {
  question: QuestionListItem;
  agentStatus: AgentStatus;
  agent?: AgentResponse;
  connectionId?: number;
  /** La URL de la lista, para que "Aprobar" vuelva acá. */
  returnTo: string;
}

const { question: q, agentStatus, agent, connectionId, returnTo } = Astro.props;
const pub = q.publication;
const detailHref = `/preguntas/${q.id}${connectionId ? `?connection=${connectionId}` : ''}`;
const answered = q.status === 'ANSWERED';
const pending = agentStatus === 'pendiente' && agent?.status === 'pendiente';
---

<article class="q">
  <div class="thumb">
    {pub?.thumbnail ? <img src={pub.thumbnail} alt="" loading="lazy" /> : <span aria-hidden="true">📦</span>}
  </div>

  <div class="body">
    <div class="meta">
      <span class:list={['ml-status', { answered }]}>{ML_STATUS_LABEL[q.status] ?? q.status}</span>
      <span class="muted" title={formatDate(q.date_created)}>{timeAgo(q.date_created)}</span>
      {q.from?.nickname && <span class="muted">{q.from.nickname}</span>}
    </div>

    <p class="text">{q.text}</p>

    {
      pub && (
        <div class="pub muted">
          {pub.permalink ? (
            <a href={pub.permalink} target="_blank" rel="noopener">{pub.title ?? pub.item_id}</a>
          ) : (
            <span>{pub.title ?? q.item_id}</span>
          )}
          {pub.price != null && <span> · {formatPrice(pub.price, pub.currency_id)}</span>}
        </div>
      )
    }

    {pending ? (
      <p class="reply proposed full"><span class="reply-label">Propuesta del agente</span>{agent.respuestaPropuesta}</p>
    ) : q.answer?.text ? (
      <p class="reply"><span class="reply-label">Respuesta publicada</span>{q.answer.text}</p>
    ) : agent ? (
      <p class:list={['reply', 'proposed', agent.status]}>
        <span class="reply-label">Respuesta del agente ({REVISION_LABEL[agent.status]})</span>{agent.respuestaEnviada ?? agent.respuestaPropuesta}
      </p>
    ) : null}
  </div>

  <div class="side">
    <AgentBadge status={agentStatus} />
    <div class="actions">
      {/* La bandeja abre el detalle en un modal; Ctrl+clic, en otra pestaña. */}
      <a
        href={detailHref}
        class="btn btn-sm btn-outline"
        data-detalle
        data-pregunta={q.text}
        title={pending ? 'Abre la pregunta para editar la propuesta antes de enviarla' : 'Abre el detalle de la pregunta'}
      >
        {pending ? '✎ Editar' : 'Ver detalle'}
      </a>
      {
        pending && (
          <form method="post" action="/api/revision" class="approve">
            <input type="hidden" name="id" value={agent!.id} />
            <input type="hidden" name="question_id" value={q.id} />
            {connectionId && <input type="hidden" name="connection" value={connectionId} />}
            <input type="hidden" name="volver" value={returnTo} />
            <button type="submit" class="btn btn-sm btn-primary" data-loading="Aprobando…" title="Aprueba la propuesta del agente tal cual">
              ✓ Aprobar
            </button>
          </form>
        )
      }
    </div>
  </div>
</article>

<style>
  /* Fila de la lista de conversaciones de Chatwoot: sin card propia, separada
     por una línea. No es clickeable: el detalle se abre con "Editar"/"Ver detalle". */
  .q {
    position: relative;
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr) auto;
    gap: 14px;
    padding: 14px 12px;
    border-radius: 8px;
    align-items: center;
  }
  .q + :global(.q)::before {
    content: '';
    position: absolute;
    top: 0;
    left: 12px;
    right: 12px;
    border-top: 1px solid rgb(var(--border-weak));
  }
  .thumb {
    width: 48px;
    height: 48px;
    border-radius: 8px;
    outline: 1px solid rgb(var(--border-container));
    outline-offset: -1px;
    background: #fff;
    display: grid;
    place-items: center;
    overflow: hidden;
    font-size: 20px;
    align-self: start;
  }
  .thumb img { width: 100%; height: 100%; object-fit: contain; }
  .body { min-width: 0; }
  .meta { display: flex; flex-wrap: wrap; gap: 4px 10px; font-size: 12px; align-items: center; color: var(--text-muted); }
  .meta .muted { color: var(--text-faint); }
  .ml-status { font-weight: 500; color: var(--revision); }
  .ml-status.answered { color: var(--si); }
  .text {
    display: block;
    margin: 2px 0;
    color: var(--text);
    font-size: 14px;
    font-weight: 500;
    line-height: 1.45;
    overflow-wrap: anywhere;
  }
  .pub { font-size: 12px; color: var(--text-muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .pub a { color: inherit; }
  .pub a:hover { color: var(--link); }
  .reply {
    margin: 8px 0 0;
    font-size: 13px;
    line-height: 1.45;
    color: var(--text-muted);
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow-wrap: anywhere;
  }
  /* Lo del agente es una nota privada en Chatwoot: se ve como tal. */
  .reply.proposed {
    padding: 8px 10px;
    border-radius: 8px;
    background: rgb(var(--solid-amber));
    color: rgb(var(--amber-12));
  }
  /* La propuesta pendiente entera: se puede aprobar desde acá, que se lea todo. */
  .reply.full { display: block; outline: 1px dashed rgb(var(--amber-12) / 0.5); outline-offset: -1px; }
  .reply-label { font-weight: 600; margin-right: 6px; color: inherit; }
  .reply:not(.proposed) .reply-label { color: var(--text); }
  .side { display: flex; flex-direction: column; align-items: flex-end; gap: 10px; min-width: 150px; }
  .actions { display: flex; gap: 8px; align-items: center; }
  .approve { margin: 0; }

  @media (max-width: 640px) {
    .q { grid-template-columns: 40px 1fr; gap: 10px 12px; padding: 12px 8px; }
    .thumb { width: 40px; height: 40px; }
    .side { grid-column: 2; flex-direction: row; justify-content: space-between; align-items: center; min-width: 0; width: 100%; }
    .reply { display: none; }
    .reply.full { display: block; }
    .pub { white-space: normal; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  }
</style>
