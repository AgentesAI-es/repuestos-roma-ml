---
import { AGENT_STATUS_META } from '../lib/agent-responses';
import type { AgentStatus } from '../lib/types';

interface Props {
  status: AgentStatus;
  size?: 'sm' | 'md';
}

const { status, size = 'sm' } = Astro.props;
const meta = AGENT_STATUS_META[status];
---

<span class:list={['badge', status, size]} title={meta.hint}>
  <span class="dot" aria-hidden="true"></span>{meta.label}
</span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 2px 10px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 600;
    white-space: nowrap;
  }
  .badge.md { font-size: 14px; padding: 4px 12px; }
  .dot { width: 7px; height: 7px; border-radius: 50%; background: currentColor; }
  .si { color: var(--si); background: var(--si-bg); }
  .no { color: var(--no); background: var(--no-bg); }
  .inseguro { color: var(--inseguro); background: var(--inseguro-bg); }
  .sin_evaluar { color: var(--sin); background: var(--sin-bg); }
</style>
