---
import { AGENT_STATUS_META } from '../lib/agent-responses';
import type { AgentStatus } from '../lib/types';

interface Props {
  status: AgentStatus;
  size?: 'sm' | 'md';
}

const { status, size = 'sm' } = Astro.props;
const meta = AGENT_STATUS_META[status];
---

<span class:list={['badge', status, size]} title={meta.hint}>
  <span class="dot" aria-hidden="true"></span>{meta.label}
</span>

<style>
  /* Label de Chatwoot (components-next/label, compacto): contorno fino y un
     cuadradito del color del estado. */
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 24px;
    padding: 0 8px;
    border-radius: 6px;
    outline: 1px solid rgb(var(--border-strong));
    outline-offset: -1px;
    background: var(--surface);
    color: var(--text);
    font-size: 12px;
    font-weight: 500;
    white-space: nowrap;
  }
  .badge.md { height: 28px; padding: 0 10px; font-size: 13px; }
  .dot { width: 6px; height: 6px; border-radius: 2px; flex: none; background: rgb(var(--slate-9)); }
  .pendiente .dot { background: rgb(var(--amber-9)); }
  .respondida .dot { background: rgb(var(--teal-9)); }
</style>
