---
import { formatPrice } from '../lib/format';
import type { ItemSummary, Publication } from '../lib/types';

interface Props {
  item: ItemSummary | null | undefined;
  pub: Publication | null | undefined;
  itemId: string | null;
}

const { item, pub, itemId } = Astro.props;
const title = item?.title ?? pub?.title ?? itemId ?? 'Publicación';
const permalink = item?.permalink ?? pub?.permalink ?? null;
const image = item?.pictures?.[0]?.secure_url ?? item?.secure_thumbnail ?? pub?.thumbnail ?? null;
const price = formatPrice(item?.price ?? pub?.price, item?.currency_id ?? pub?.currency_id);
const attributes = (item?.attributes ?? []).filter((a) => a.value_name);
const condition = item?.condition === 'new' ? 'Nuevo' : item?.condition === 'used' ? 'Usado' : item?.condition;
// Estados de una publicación en ML.
const ESTADOS: Record<string, string> = {
  active: 'Activa',
  paused: 'Pausada',
  closed: 'Finalizada',
  under_review: 'En revisión',
  inactive: 'Inactiva',
  payment_required: 'Pago pendiente',
};
const estado = item?.status ?? pub?.status ?? '';
const facts: [string, string | number][] = [
  ['Stock', item?.available_quantity ?? ''],
  ['Vendidos', item?.sold_quantity ?? ''],
  ['Condición', condition ?? ''],
  ['Estado', ESTADOS[estado] ?? estado],
].filter(([, v]) => v !== '' && v != null) as [string, string | number][];
---

<div class="pub">
  {image && <img src={image} alt={title} loading="lazy" />}
  <h3>{permalink ? <a href={permalink} target="_blank" rel="noopener">{title}</a> : title}</h3>
  {price && <p class="price">{price}</p>}
  {
    facts.length > 0 && (
      <dl>
        {facts.map(([k, v]) => (
          <>
            <dt>{k}</dt>
            <dd>{v}</dd>
          </>
        ))}
      </dl>
    )
  }
  {
    attributes.length > 0 && (
      <details>
        <summary>Características ({attributes.length})</summary>
        <dl class="attrs">
          {attributes.map((a) => (
            <>
              <dt>{a.name}</dt>
              <dd>{a.value_name}</dd>
            </>
          ))}
        </dl>
      </details>
    )
  }
</div>

<style>
  .pub img {
    width: 100%;
    aspect-ratio: 1.3;
    object-fit: contain;
    background-color: #fff;
    border-radius: 8px;
    outline: 1px solid rgb(var(--border-container));
    outline-offset: -1px;
    margin-bottom: 12px;
  }
  h3 { font-size: 14px; font-weight: 500; margin: 0 0 4px; line-height: 1.45; overflow-wrap: anywhere; }
  h3 a { color: var(--text); }
  h3 a:hover { color: var(--link); }
  .price { font-size: 18px; font-weight: 600; margin: 0 0 12px; }
  dl { display: grid; grid-template-columns: max-content 1fr; gap: 6px 12px; margin: 0; font-size: 13px; }
  dt { color: var(--text-muted); }
  dd { margin: 0; overflow-wrap: anywhere; }
  details { margin-top: 14px; padding-top: 12px; border-top: 1px solid rgb(var(--border-weak)); }
  summary { cursor: pointer; font-weight: 500; font-size: 13px; margin-bottom: 8px; }
  /* Nombre arriba y valor abajo: en dos columnas las descripciones largas
     quedaban apretadas y cortadas. */
  .attrs { display: block; font-size: 12px; }
  .attrs dt { margin-top: 10px; }
  .attrs dt:first-child { margin-top: 0; }
  .attrs dd { margin-top: 2px; line-height: 1.45; white-space: pre-line; }
</style>
