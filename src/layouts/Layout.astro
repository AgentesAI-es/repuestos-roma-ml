---
import '../styles/global.css';
import { agentSource } from '../lib/agent-responses';
import { connectionName, resolveConnectionId } from '../lib/accounts';
import { getConnections } from '../lib/ml-api';
import type { Connection } from '../lib/types';

interface Props {
  title?: string;
  /** Cuenta que se está viendo; sin esto, la default. */
  connectionId?: number;
  /** La grilla de cuentas (la bandeja sí; el detalle no, para entrar en la pantalla). */
  accounts?: boolean;
  /** Menos aire alrededor del contenido: el detalle ocupa el alto de la pantalla. */
  fill?: boolean;
  /** Sin barra ni cuentas ni márgenes: el detalle dentro del modal de la bandeja. */
  bare?: boolean;
}

const { title, connectionId, accounts = true, fill = false, bare = false } = Astro.props;
const source = agentSource();

// Las cuentas se cachean un minuto en ml-api. Si la API de ML falla,
// la página muestra su propio error.
let cuentas: Connection[] = [];
try {
  if (accounts && !bare) cuentas = (await getConnections()).connections;
} catch (err) {
  console.error('[layout] cuentas', err);
}
const actual = resolveConnectionId(cuentas, connectionId);

function iniciales(nombre: string) {
  const partes = nombre.trim().split(/\s+/).filter(Boolean);
  const letras = partes.length > 1 ? partes[0][0] + partes[partes.length - 1][0] : nombre.slice(0, 2);
  return letras.toUpperCase();
}
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title ? `${title} · Preguntas ML` : 'Preguntas ML · Repuestos Roma'}</title>
  </head>
  <body>
    <div id="nav-progress" class="nav-progress" hidden></div>
    <p id="nav-status" class="sr-only" aria-live="polite"></p>
    {!bare && <header class="topbar">
      <div class="container topbar-inner">
        <a href="/" class="brand">
          <span class="logo" aria-hidden="true">R</span>
          <span class="brand-text"><strong>Repuestos Roma</strong><small>Centro de preguntas</small></span>
        </a>
        <span class="source" title="Origen de los estados del agente">
          Agente:{' '}
          {source === 'repuestos' && 'API repuestos'}
          {source === 'mock' && 'datos simulados'}
          {source === 'none' && 'sin conectar'}
        </span>
      </div>
    </header>}
    {
      accounts && !bare && cuentas.length > 0 && (
        <nav class="accounts" aria-label="Cuentas de Mercado Libre">
          <div class="container accounts-inner">
            {cuentas.map((c) => {
              const nombre = connectionName(c);
              const secundario = c.nickname && c.nickname !== nombre ? c.nickname : null;
              return (
                <a
                  href={`/?connection=${c.id}`}
                  class:list={['account', { active: c.id === actual }]}
                  aria-current={c.id === actual ? 'page' : undefined}
                  data-connection={c.id}
                  data-actual={c.id === actual ? '1' : undefined}
                >
                  <span class="account-id">
                    <span class="avatar" aria-hidden="true">{iniciales(nombre)}</span>
                    <span class="account-text">
                      <span class="account-name">{nombre}</span>
                      {secundario && <span class="account-nick">{secundario}</span>}
                      {!c.authenticated && <span class="account-warn">Sesión vencida</span>}
                    </span>
                  </span>
                  <span class="metrics">
                    <span class="metric" title="Respuestas del agente pendientes de revisión">
                      <span class="metric-value is-loading" data-k="pendientes"></span>
                      <span class="metric-label">En revisión</span>
                    </span>
                    <span class="metric" title="Sin responder en Mercado Libre">
                      <span class="metric-value is-loading" data-k="sinResponder"></span>
                      <span class="metric-label">Sin responder</span>
                    </span>
                    <span class="metric" title="Respondidas en Mercado Libre">
                      <span class="metric-value is-loading" data-k="respondidas"></span>
                      <span class="metric-label">Respondidas</span>
                    </span>
                  </span>
                </a>
              );
            })}
          </div>
        </nav>
      )
    }
    <main class:list={['container', { fill, bare }]}>
      <slot />
    </main>
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var bar = document.getElementById('nav-progress');
        var status = document.getElementById('nav-status');

        function paintControl(el) {
          if (!el || el.dataset.loadingApplied === '1') return;
          el.dataset.loadingApplied = '1';
          el.classList.add('is-loading');
          el.setAttribute('aria-busy', 'true');
          var spinner = document.createElement('span');
          spinner.className = 'spinner';
          spinner.setAttribute('aria-hidden', 'true');
          if (el.dataset.loading) el.replaceChildren(spinner, document.createTextNode(el.dataset.loading));
          else el.prepend(spinner);
        }

        function beginNavigation(trigger) {
          root.classList.add('is-navigating');
          if (bar) bar.hidden = false;
          var message = (trigger && trigger.dataset && trigger.dataset.loading) || 'Cargando…';
          if (status) status.textContent = message;
          if (trigger && trigger.matches('a.btn, button')) paintControl(trigger);
        }

        function isPlainClick(event) {
          return event.button === 0 && !event.metaKey && !event.ctrlKey && !event.shiftKey && !event.altKey;
        }

        document.addEventListener('click', function (event) {
          if (event.defaultPrevented || !isPlainClick(event)) return;
          var link = event.target instanceof Element ? event.target.closest('a') : null;
          if (!link || link.hasAttribute('download')) return;
          if (link.target && link.target !== '_self') return;
          if (link.getAttribute('aria-disabled') === 'true') return;
          var url;
          try {
            url = new URL(link.href, location.href);
          } catch (err) {
            return;
          }
          if (url.origin !== location.origin) return;
          if (url.pathname === location.pathname && url.search === location.search && url.hash !== location.hash) return;
          beginNavigation(link);
        });

        document.addEventListener('submit', function (event) {
          var form = event.target;
          if (!(form instanceof HTMLFormElement) || event.defaultPrevented) return;
          var submitter = event.submitter instanceof HTMLElement ? event.submitter : null;
          beginNavigation(submitter || form.querySelector('button[data-loading], button[type="submit"]'));
          setTimeout(function () {
            form.querySelectorAll('button').forEach(function (btn) {
              btn.disabled = true;
            });
          }, 0);
        });

        document.querySelectorAll('img').forEach(function (img) {
          if (img.complete && img.naturalWidth > 0) return;
          img.classList.add('img-loading');
          var done = function () {
            img.classList.remove('img-loading');
          };
          img.addEventListener('load', done, { once: true });
          img.addEventListener('error', done, { once: true });
        });

        window.addEventListener('pageshow', function () {
          root.classList.remove('is-navigating');
          if (bar) bar.hidden = true;
          if (status) status.textContent = '';
        });
      })();
    </script>
    <script>
      // Conteos por cuenta, en segundo plano: la página ya está renderizada y
      // usable mientras llegan. Primero la cuenta actual, después el resto en
      // paralelo.
      type Resumen = Record<'sinResponder' | 'pendientes' | 'respondidas', number | null>;

      const tabs = [...document.querySelectorAll<HTMLElement>('.accounts [data-connection]')];
      const numero = new Intl.NumberFormat('es-AR');

      function pintar(tab: HTMLElement, resumen: Resumen | null) {
        tab.querySelectorAll<HTMLElement>('[data-k]').forEach((el) => {
          const valor = resumen?.[el.dataset.k as keyof Resumen];
          el.textContent = typeof valor === 'number' ? numero.format(valor) : '—';
          el.classList.remove('is-loading');
        });
        const pendientes = resumen?.pendientes ?? 0;
        tab.classList.toggle('has-pending', pendientes > 0);
      }

      async function cargar(tab: HTMLElement) {
        try {
          const res = await fetch(`/api/resumen?connection=${tab.dataset.connection}`);
          pintar(tab, res.ok ? ((await res.json()) as Resumen) : null);
        } catch {
          pintar(tab, null);
        }
      }

      const primera = tabs.find((t) => t.dataset.actual === '1');
      (async () => {
        if (primera) await cargar(primera);
        await Promise.all(tabs.filter((t) => t !== primera).map(cargar));
      })();
    </script>
  </body>
</html>

<style>
  .topbar {
    background: var(--brand);
    color: var(--brand-contrast);
    border-bottom: 1px solid rgb(255 255 255 / 0.1);
  }
  .topbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 68px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    color: inherit;
    font-size: 16px;
    text-decoration: none !important;
  }
  .logo {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 11px;
    background: var(--accent);
    color: var(--brand);
    font-weight: 800;
  }
  .brand-text { display: flex; flex-direction: column; line-height: 1.15; }
  .brand-text small { font-size: 12px; font-weight: 400; opacity: 0.78; margin-top: 3px; }
  .source {
    font-size: 13px;
    opacity: 0.85;
    white-space: nowrap;
  }
  main { padding-block: 30px 56px; }
  main.fill { padding-block: 14px 16px; }
  main.bare { max-width: none; padding: 0; }

  .accounts {
    background: var(--bg);
    border-bottom: 1px solid var(--border);
  }
  .accounts-inner {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    padding-block: 12px;
  }
  .account {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-width: 0;
    padding: 10px 14px;
    border: 1px solid var(--border);
    border-radius: 12px;
    color: var(--text);
    text-decoration: none !important;
    background: var(--surface);
  }
  .account:hover { background: var(--surface-2); }
  .account.active {
    border-color: var(--link);
    box-shadow: inset 0 0 0 1px var(--link), var(--shadow);
  }
  .account-id {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }
  .avatar {
    display: grid;
    place-items: center;
    flex: none;
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: var(--surface-2);
    /* --link y no --brand: --brand es casi negro en modo oscuro. */
    color: var(--link);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.02em;
  }
  .account.active .avatar { background: var(--brand); color: #fff; }
  .account-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .account-name {
    font-weight: 650;
    font-size: 14px;
    line-height: 1.25;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .account-nick,
  .account-warn { font-size: 12px; line-height: 1.3; }
  .account-nick { color: var(--text-muted); }
  .account-warn { color: var(--no); font-weight: 600; }
  .metrics { display: flex; flex: none; gap: 14px; margin-left: auto; }
  .metric { display: flex; flex-direction: column; align-items: center; min-width: 54px; }
  .metric-value {
    font-size: 17px;
    font-weight: 700;
    line-height: 1.2;
    font-variant-numeric: tabular-nums;
    color: var(--text);
  }
  .metric-label { color: var(--text-muted); font-size: 10px; white-space: nowrap; }
  .metric-value.is-loading {
    display: inline-block;
    width: 1.6rem;
    height: 0.7rem;
    border-radius: 4px;
    background: var(--border);
    color: transparent;
    vertical-align: middle;
    animation: metric-pulse 1.1s ease-in-out infinite;
  }
  .account.has-pending .metric:first-child .metric-value { color: var(--revision); }

  @keyframes metric-pulse {
    50% { opacity: 0.4; }
  }
  @media (prefers-reduced-motion: reduce) {
    .metric-value.is-loading { animation: none; }
  }

  @media (max-width: 1000px) {
    .account { flex-direction: column; align-items: stretch; }
    .metrics { justify-content: space-between; margin-left: 0; }
  }

  @media (max-width: 640px) {
    .accounts-inner { grid-template-columns: minmax(0, 1fr); }
    .account { flex-direction: row; align-items: center; }
  }

  @media (max-width: 560px) {
    .source { display: none; }
    .account { flex-direction: column; align-items: stretch; }
    .metrics { gap: 7px; }
    .metric { min-width: 48px; }
    .metric-label { font-size: 9px; }
  }
</style>
