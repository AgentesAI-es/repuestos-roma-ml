---
import '../styles/global.css';
import { connectionName, resolveConnectionId } from '../lib/accounts';
import { getConnections } from '../lib/ml-api';
import { ultimoResumen } from '../lib/server/resumen';
import type { Connection } from '../lib/types';

interface Props {
  title?: string;
  /** Cuenta que se está viendo; sin esto, la default. */
  connectionId?: number;
  /** La grilla de cuentas (la bandeja sí; el detalle no, para entrar en la pantalla). */
  accounts?: boolean;
  /** Menos aire alrededor del contenido: el detalle ocupa el alto de la pantalla. */
  fill?: boolean;
  /** Sin cuentas ni márgenes: el detalle dentro del modal de la bandeja. */
  bare?: boolean;
  /** La página ocupa justo la pantalla y no scrollea: el contenido maneja su propio scroll (la bandeja). */
  fit?: boolean;
}

const { title, connectionId, accounts = true, fill = false, bare = false, fit = false } = Astro.props;

// Las cuentas se cachean un minuto en ml-api. Si la API de ML falla,
// la página muestra su propio error.
let cuentas: Connection[] = [];
try {
  if (accounts && !bare) cuentas = (await getConnections()).connections;
} catch (err) {
  console.error('[layout] cuentas', err);
}
const actual = resolveConnectionId(cuentas, connectionId);

// Las métricas que ya se conocen salen en el HTML: el esqueleto solo se ve la
// primera vez (o después de reiniciar el server). El navegador las refresca igual.
const numero = new Intl.NumberFormat('es-AR');
const METRICAS = [
  { k: 'pendientes', label: 'En revisión', title: 'Respuestas del agente pendientes de revisión' },
  { k: 'sinResponder', label: 'Sin responder', title: 'Sin responder en Mercado Libre' },
  { k: 'respondidas', label: 'Respondidas', title: 'Respondidas en Mercado Libre' },
] as const;

function iniciales(nombre: string) {
  const partes = nombre.trim().split(/\s+/).filter(Boolean);
  const letras = partes.length > 1 ? partes[0][0] + partes[partes.length - 1][0] : nombre.slice(0, 2);
  return letras.toUpperCase();
}
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title ? `${title} · HM-ML` : 'HM-ML · Preguntas de Mercado Libre'}</title>
  </head>
  <body class:list={{ fit }}>
    <div id="nav-progress" class="nav-progress" hidden></div>
    <p id="nav-status" class="sr-only" aria-live="polite"></p>
    {
      accounts && !bare && cuentas.length > 0 && (
        <nav class="accounts" aria-label="Cuentas de Mercado Libre">
          <div class="container accounts-inner">
            {cuentas.map((c) => {
              const nombre = connectionName(c);
              const secundario = c.nickname && c.nickname !== nombre ? c.nickname : null;
              const resumen = ultimoResumen(c.id);
              return (
                <a
                  href={`/?connection=${c.id}`}
                  class:list={['account', { active: c.id === actual, 'has-pending': (resumen?.pendientes ?? 0) > 0 }]}
                  aria-current={c.id === actual ? 'page' : undefined}
                  data-connection={c.id}
                  data-precargar
                  data-actual={c.id === actual ? '1' : undefined}
                >
                  <span class="account-id">
                    <span class="avatar" aria-hidden="true">{iniciales(nombre)}</span>
                    <span class="account-text">
                      <span class="account-name">{nombre}</span>
                      {secundario && <span class="account-nick">{secundario}</span>}
                      {!c.authenticated && <span class="account-warn">Sesión vencida</span>}
                    </span>
                  </span>
                  <span class="metrics">
                    {METRICAS.map((m) => {
                      const valor = resumen?.[m.k];
                      return (
                        <span class="metric" title={m.title}>
                          <span class:list={['metric-value', { 'is-loading': !resumen }]} data-k={m.k}>
                            {resumen ? (typeof valor === 'number' ? numero.format(valor) : '—') : ''}
                          </span>
                          <span class="metric-label">{m.label}</span>
                        </span>
                      );
                    })}
                  </span>
                </a>
              );
            })}
          </div>
        </nav>
      )
    }
    <main class:list={['container', { fill, bare }]}>
      <slot />
    </main>
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var bar = document.getElementById('nav-progress');
        var status = document.getElementById('nav-status');

        function paintControl(el) {
          if (!el || el.dataset.loadingApplied === '1') return;
          el.dataset.loadingApplied = '1';
          el.classList.add('is-loading');
          el.setAttribute('aria-busy', 'true');
          var spinner = document.createElement('span');
          spinner.className = 'spinner';
          spinner.setAttribute('aria-hidden', 'true');
          if (el.dataset.loading) el.replaceChildren(spinner, document.createTextNode(el.dataset.loading));
          else el.prepend(spinner);
        }

        function beginNavigation(trigger) {
          root.classList.add('is-navigating');
          if (bar) bar.hidden = false;
          var message = (trigger && trigger.dataset && trigger.dataset.loading) || 'Cargando…';
          if (status) status.textContent = message;
          if (trigger && trigger.matches('a.btn, button')) paintControl(trigger);
        }

        function isPlainClick(event) {
          return event.button === 0 && !event.metaKey && !event.ctrlKey && !event.shiftKey && !event.altKey;
        }

        document.addEventListener('click', function (event) {
          if (event.defaultPrevented || !isPlainClick(event)) return;
          var link = event.target instanceof Element ? event.target.closest('a') : null;
          if (!link || link.hasAttribute('download')) return;
          if (link.target && link.target !== '_self') return;
          if (link.getAttribute('aria-disabled') === 'true') return;
          var url;
          try {
            url = new URL(link.href, location.href);
          } catch (err) {
            return;
          }
          if (url.origin !== location.origin) return;
          if (url.pathname === location.pathname && url.search === location.search && url.hash !== location.hash) return;
          beginNavigation(link);
        });

        document.addEventListener('submit', function (event) {
          var form = event.target;
          if (!(form instanceof HTMLFormElement) || event.defaultPrevented) return;
          var submitter = event.submitter instanceof HTMLElement ? event.submitter : null;
          beginNavigation(submitter || form.querySelector('button[data-loading], button[type="submit"]'));
          setTimeout(function () {
            form.querySelectorAll('button').forEach(function (btn) {
              btn.disabled = true;
            });
          }, 0);
        });

        document.querySelectorAll('img').forEach(function (img) {
          if (img.complete && img.naturalWidth > 0) return;
          img.classList.add('img-loading');
          var done = function () {
            img.classList.remove('img-loading');
          };
          img.addEventListener('load', done, { once: true });
          img.addEventListener('error', done, { once: true });
        });

        // Precarga: al pasar el mouse (o el foco) por una cuenta o una pestaña,
        // se pide esa página de fondo. La respuesta se tira: lo que sirve es que
        // el server deja lo de ML en su caché, y el clic llega sin esperar a ML.
        // No usa el caché del navegador: así la página sale con el estado del
        // agente al momento del clic. Cada link, a lo sumo una vez cada 30 s.
        var precargadas = {};
        var precargaPendiente = null;
        function precargar(link) {
          var href = link.href;
          if (href === location.href || Date.now() - (precargadas[href] || 0) < 30000) return;
          precargadas[href] = Date.now();
          fetch(href, { credentials: 'same-origin', priority: 'low' }).catch(function () {
            delete precargadas[href];
          });
        }
        function alApuntar(event) {
          var link = event.target instanceof Element ? event.target.closest('a[data-precargar]') : null;
          if (!link) return;
          clearTimeout(precargaPendiente);
          // Una pausa corta: pasar el mouse de largo no dispara nada.
          precargaPendiente = setTimeout(function () {
            precargar(link);
          }, event.type === 'focusin' ? 0 : 80);
        }
        document.addEventListener('pointerover', alApuntar);
        document.addEventListener('focusin', alApuntar);
        document.addEventListener('pointerout', function () {
          clearTimeout(precargaPendiente);
        });

        window.addEventListener('pageshow', function () {
          root.classList.remove('is-navigating');
          if (bar) bar.hidden = true;
          if (status) status.textContent = '';
        });
      })();
    </script>
    <script>
      // Conteos por cuenta, en segundo plano: la página ya está renderizada y
      // usable mientras llegan. Si el server ya los conocía vienen en el HTML y
      // esto solo los actualiza en el lugar, sin esqueleto. Primero la cuenta
      // actual, después el resto en paralelo; y de nuevo cada minuto mientras
      // la pestaña está a la vista.
      type Resumen = Record<'sinResponder' | 'pendientes' | 'respondidas', number | null>;

      const REFRESCO_MS = 60_000;
      const tabs = [...document.querySelectorAll<HTMLElement>('.accounts [data-connection]')];
      const numero = new Intl.NumberFormat('es-AR');

      function pintar(tab: HTMLElement, resumen: Resumen) {
        tab.querySelectorAll<HTMLElement>('[data-k]').forEach((el) => {
          const valor = resumen[el.dataset.k as keyof Resumen];
          el.textContent = typeof valor === 'number' ? numero.format(valor) : '—';
          el.classList.remove('is-loading');
        });
        tab.classList.toggle('has-pending', (resumen.pendientes ?? 0) > 0);
      }

      async function cargar(tab: HTMLElement) {
        let resumen: Resumen | null = null;
        try {
          const res = await fetch(`/api/resumen?connection=${tab.dataset.connection}`);
          if (res.ok) resumen = (await res.json()) as Resumen;
        } catch {}
        if (resumen) pintar(tab, resumen);
        // Si falla, queda el último número que se vio; "—" solo si nunca hubo uno.
        else tab.querySelectorAll<HTMLElement>('[data-k].is-loading').forEach((el) => {
          el.textContent = '—';
          el.classList.remove('is-loading');
        });
      }

      let ultimo = 0;
      async function refrescar() {
        ultimo = Date.now();
        const primera = tabs.find((t) => t.dataset.actual === '1');
        if (primera) await cargar(primera);
        await Promise.all(tabs.filter((t) => t !== primera).map(cargar));
      }

      if (tabs.length) {
        refrescar();
        setInterval(() => {
          if (document.visibilityState === 'visible') refrescar();
        }, REFRESCO_MS);
        // Al volver a la pestaña después de un rato, no esperar al próximo intervalo.
        document.addEventListener('visibilitychange', () => {
          if (document.visibilityState === 'visible' && Date.now() - ultimo >= REFRESCO_MS) refrescar();
        });
      }
    </script>
  </body>
</html>

<style>
  main { padding-block: 24px 48px; }
  main.fill { padding-block: 12px 16px; }

  /* Modo "cabe en la pantalla": cuentas arriba, y main toma el resto
     como columna flex; lo que scrollea es un hijo de main (min-height: 0). */
  body.fit { height: 100dvh; display: flex; flex-direction: column; overflow: hidden; }
  body.fit > .accounts { flex: none; }
  body.fit > main { flex: 1; min-height: 0; width: 100%; display: flex; flex-direction: column; padding-block: 12px 16px; }
  /* En una pantalla muy baja no entra: vuelve el scroll normal de la página. */
  @media (max-height: 540px) {
    body.fit { height: auto; overflow: visible; display: block; }
  }
  main.bare { max-width: none; padding: 0; }

  .accounts-inner {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
    padding-block: 12px 0;
  }
  /* Cards de Chatwoot: superficie con contorno fino; la activa, en azul. */
  .account {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-width: 0;
    padding: 10px 14px;
    border-radius: 12px;
    outline: 1px solid var(--border);
    outline-offset: -1px;
    color: var(--text);
    text-decoration: none !important;
    background: var(--surface);
    transition: background-color 0.1s ease-out;
  }
  .account:hover { background: rgb(var(--alpha-1)); }
  .account.active {
    outline-color: var(--brand);
    background: rgb(var(--blue-9) / 0.06);
  }
  .account-id {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }
  /* Avatar de iniciales de Chatwoot: redondo, tono suave de la marca. */
  .avatar {
    display: grid;
    place-items: center;
    flex: none;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgb(var(--blue-3));
    color: var(--link);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.02em;
  }
  .account.active .avatar { background: var(--brand); color: #fff; }
  .account-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .account-name {
    font-weight: 500;
    font-size: 14px;
    line-height: 1.3;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .account-nick,
  .account-warn { font-size: 12px; line-height: 1.3; }
  .account-nick { color: var(--text-muted); }
  .account-warn { color: var(--no); font-weight: 500; }
  .metrics { display: flex; flex: none; gap: 16px; margin-left: auto; }
  .metric { display: flex; flex-direction: column; align-items: flex-end; min-width: 48px; }
  .metric-value {
    font-size: 14px;
    font-weight: 600;
    line-height: 1.3;
    font-variant-numeric: tabular-nums;
    color: var(--text);
  }
  .metric-label { color: var(--text-faint); font-size: 11px; white-space: nowrap; }
  .metric-value.is-loading {
    display: inline-block;
    width: 1.6rem;
    height: 0.7rem;
    margin-block: 0.15rem;
    border-radius: 4px;
    background: rgb(var(--slate-4));
    color: transparent;
    animation: metric-pulse 1.1s ease-in-out infinite;
  }
  .account.has-pending .metric:first-child .metric-value { color: var(--revision); }

  @keyframes metric-pulse {
    50% { opacity: 0.4; }
  }
  @media (prefers-reduced-motion: reduce) {
    .metric-value.is-loading { animation: none; }
  }

  @media (max-width: 1000px) {
    .account { flex-direction: column; align-items: stretch; }
    .metrics { justify-content: space-between; margin-left: 0; }
    .metric { align-items: flex-start; }
  }

  /* En celular las cuentas no se apilan (se comían la pantalla): van en una
     fila que se desliza de costado, y se ve un pedazo de la siguiente. */
  @media (max-width: 640px) {
    .accounts-inner { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; padding-block: 10px 0; }
    .account { flex: 0 0 82%; scroll-snap-align: start; flex-direction: row; align-items: center; }
  }

  @media (max-width: 560px) {
    .account { flex-direction: column; align-items: stretch; }
    .metrics { gap: 8px; }
    .metric { min-width: 44px; }
    .metric-label { font-size: 10px; }
  }
</style>
