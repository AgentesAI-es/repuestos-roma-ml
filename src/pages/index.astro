---
import Layout from '../layouts/Layout.astro';
import QuestionCard from '../components/QuestionCard.astro';
import { ApiError, getConnections } from '../lib/ml-api';
import { getQuestionCacheada, listQuestionsCacheada } from '../lib/server/ml-cache';
import { resolveConnectionId } from '../lib/accounts';
import {
  AGENT_STATUS_META,
  agentSource,
  agentStatusOf,
  countPending,
  getAgentResponses,
  isAgentStatus,
  listByStatus,
} from '../lib/agent-responses';
import { dayToIso } from '../lib/format';
import type { AgentResponse, AgentStatus, Connection, QuestionListItem } from '../lib/types';

const PAGE_SIZE = 50;
const params = Astro.url.searchParams;

/**
 * Las pestañas son el único filtro de estado, ordenadas por cuánta atención
 * piden. Cada una trae sus datos de otra forma:
 *
 *   pendiente      las filas `pendiente` de la tabla de revisión, con el detalle
 *                  de cada pregunta desde ML (todas, no solo las de una página)
 *   sin_responder  UNANSWERED de ML, sin las que ya tienen revisión
 *   aprobadas      las filas `aprobado` y `editado` de la tabla de revisión: lo que
 *                  respondió el agente con el visto bueno de una persona
 *   respondida     todas las de ML que estén respondidas en ML, aprobadas o editadas
 *   todas          todas las de ML
 *
 * "Sin responder" y "Respondidas" filtran sobre la página de ML: puede venir
 * alguna menos que 50, pero ninguna queda afuera de la paginación.
 */
type Tab = AgentStatus | 'aprobadas' | 'todas';
const TABS: { id: Tab; label: string; hint: string }[] = [
  { id: 'pendiente', label: 'Para revisar', hint: AGENT_STATUS_META.pendiente.hint },
  { id: 'sin_responder', label: 'Sin responder', hint: AGENT_STATUS_META.sin_responder.hint },
  { id: 'aprobadas', label: 'Aprobadas', hint: 'Respuestas del agente aprobadas o editadas por una persona' },
  { id: 'respondida', label: 'Respondidas', hint: AGENT_STATUS_META.respondida.hint },
  { id: 'todas', label: 'Todas', hint: 'Todas las preguntas de la cuenta' },
];
// Las que salen de la tabla de revisión y no de una página de ML.
const TAB_STATUSES: Partial<Record<Tab, AgentResponse['status'][]>> = {
  pendiente: ['pendiente'],
  aprobadas: ['aprobado', 'editado'],
};
// `agent` es el parámetro viejo: los links guardados siguen andando.
const tabParam = params.get('tab') ?? params.get('agent');
const tabElegida: Tab | null =
  tabParam === 'todas' || tabParam === 'aprobadas' || isAgentStatus(tabParam) ? (tabParam as Tab) : null;

const sort = params.get('sort') === 'asc' ? 'asc' : 'desc';
const from = params.get('from') ?? '';
const to = params.get('to') ?? '';
const page = Math.max(1, Number.parseInt(params.get('page') ?? '1', 10) || 1);
// "Actualizar": lo de ML se pide de nuevo aunque esté en el caché.
const forzar = params.get('actualizar') === '1';

let connections: Connection[] = [];
let questions: QuestionListItem[] = [];
let total = 0;
let loaded = false;
let hidden = 0;
let failedDetails = 0;
let pendingCount: number | null = null;
let error: string | null = null;
let loginUrl: string | null = null;
let connectionId: number | undefined;
let tab: Tab = tabElegida ?? 'sin_responder';

try {
  const conn = await getConnections();
  connections = conn.connections;
  loginUrl = conn.login_url;
  connectionId = resolveConnectionId(connections, Number(params.get('connection')));

  if (connectionId) {
    pendingCount = await countPending(connectionId).catch(() => null);
    // Sin pestaña elegida, se abre donde hay trabajo: revisar si hay pendientes.
    if (!tabElegida && pendingCount) tab = 'pendiente';

    const tableStatuses = TAB_STATUSES[tab];
    if (tableStatuses && agentSource() === 'db') {
      ({ questions, total, failedDetails } = await loadFromTable(connectionId, tableStatuses));
    } else {
      const data = await listQuestionsCacheada(
        {
          connection_id: connectionId,
          status: tab === 'sin_responder' ? 'UNANSWERED' : undefined,
          sort,
          from_date: dayToIso(from),
          to_date: dayToIso(to, true),
          offset: (page - 1) * PAGE_SIZE,
          limit: PAGE_SIZE,
        },
        { forzar },
      );
      questions = data.questions;
      total = data.total;
    }
    loaded = true;
  }
} catch (err) {
  error = err instanceof ApiError ? err.message : 'Error inesperado al consultar la API.';
  if (err instanceof ApiError) {
    loginUrl = (err.body as { login_url?: string } | null)?.login_url ?? loginUrl;
  }
  console.error('[index]', err);
}

const agentMap = await getAgentResponses(questions.map((q) => q.id));
const visible =
  tab === 'todas'
    ? questions
    : tab === 'aprobadas'
      ? questions.filter((q) => ['aprobado', 'editado'].includes(agentMap.get(q.id)?.status ?? ''))
      : questions.filter((q) => agentStatusOf(agentMap, q) === tab);
hidden = questions.length - visible.length;
const totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE));
// Si todo entra en una página, el número que se ve es el real (sin las de otra pestaña).
const shown = totalPages === 1 ? visible.length : total;

/** Las filas de la tabla de la cuenta, con fechas y orden aplicados acá (no pasan por el filtro de ML). */
async function loadFromTable(connection: number, statuses: AgentResponse['status'][]) {
  const rows = await listByStatus(connection, statuses);
  const details = await Promise.allSettled(rows.map((r) => getQuestionCacheada(r.questionId!, connection, { forzar })));
  const desde = dayToIso(from);
  const hasta = dayToIso(to, true);
  const all = details
    .filter((d) => d.status === 'fulfilled')
    .map((d) => ({ ...d.value.question, publication: d.value.publication }) as QuestionListItem)
    .filter((q) => (!desde || (q.date_created ?? '') >= desde) && (!hasta || (q.date_created ?? '') <= hasta))
    .sort((a, b) => (a.date_created ?? '').localeCompare(b.date_created ?? '') * (sort === 'asc' ? 1 : -1));
  return {
    questions: all.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE),
    total: all.length,
    failedDetails: details.length - details.filter((d) => d.status === 'fulfilled').length,
  };
}

// Resultado del "Aprobar" de una card (vuelve de /api/revision).
const revisionOk = params.get('revision');
const revisionError = params.get('revision_error');

function hrefWith(changes: Record<string, string | number | null>) {
  const u = new URL(Astro.url);
  for (const k of ['agent', 'status', 'revision', 'revision_error', 'actualizar']) u.searchParams.delete(k);
  for (const [k, v] of Object.entries(changes)) {
    if (v === null || v === '') u.searchParams.delete(k);
    else u.searchParams.set(k, String(v));
  }
  return `${u.pathname}${u.search}`;
}

/** Esta misma lista, sin el aviso: a donde vuelve el "Aprobar" de las cards. */
const returnTo = hrefWith({});
---

<Layout connectionId={connectionId} fit>
  <h1 class="sr-only">Preguntas de clientes</h1>

  {
    error && (
      <div class="alert alert-error" role="alert">
        <strong>No se pudieron cargar las preguntas.</strong> {error}
      </div>
    )
  }

  {
    !error && connections.length === 0 && (
      <div class="alert alert-info">
        No hay cuentas de Mercado Libre conectadas.
        {loginUrl && (
          <>
            {' '}Conectá una desde <a href={loginUrl} target="_blank" rel="noopener">{loginUrl}</a>.
          </>
        )}
      </div>
    )
  }

  {revisionOk && <div class="alert alert-success flash" role="status">Respuesta aprobada.</div>}
  {revisionError && (
    <div class="alert alert-error flash" role="alert">
      <strong>No se pudo aprobar.</strong> {revisionError}
    </div>
  )}

  <div class="toolbar">
    <nav class="state-tabs" aria-label="Filtrar por estado">
      {
        TABS.map((t) => (
          <a
            href={hrefWith({ tab: t.id, page: null })}
            data-precargar
            class:list={['state-tab', t.id, { active: tab === t.id }]}
            title={t.hint}
            aria-current={tab === t.id ? 'page' : undefined}
          >
            {t.label}
            {t.id === 'pendiente' && pendingCount ? <span class="tab-count">{pendingCount}</span> : null}
          </a>
        ))
      }
    </nav>

    <form method="get" class="controls">
      {connectionId && <input type="hidden" name="connection" value={connectionId} />}
      <input type="hidden" name="tab" value={tab} />
      <label>
        <span>Desde</span>
        <input type="date" name="from" value={from} class="input input-sm input-bordered" />
      </label>
      <label>
        <span>Hasta</span>
        <input type="date" name="to" value={to} class="input input-sm input-bordered" />
      </label>
      <label>
        <span>Orden</span>
        <select name="sort" class="select select-sm select-bordered">
          <option value="desc" selected={sort === 'desc'}>Más nuevas</option>
          <option value="asc" selected={sort === 'asc'}>Más viejas</option>
        </select>
      </label>
      {(from || to) && <a href={hrefWith({ from: null, to: null, page: null })} class="btn btn-sm btn-ghost clear">Quitar fechas</a>}
      <button type="submit" class="sr-only">Filtrar</button>
      <a href={hrefWith({ actualizar: 1 })} class="btn btn-sm btn-outline refresh" data-loading="Actualizando…" aria-label="Actualizar preguntas">
        <span aria-hidden="true">↻</span><span class="refresh-label">Actualizar</span>
      </a>
    </form>
  </div>

  {
    loaded && (hidden > 0 || failedDetails > 0 || agentSource() === 'none') && (
      <p class="muted note">
        {hidden > 0 && `${hidden} de esta página de Mercado Libre están en otra pestaña. `}
        {failedDetails > 0 && `${failedDetails} preguntas de esta pestaña no se pudieron traer de Mercado Libre. `}
        {agentSource() === 'none' && 'La revisión del agente aparece al configurar la base (DATABASE_URL).'}
      </p>
    )
  }

  {/* La página no scrollea: la lista vive en esta card y scrollea adentro. */}
  <div class="list-card">
  <div class="results-head">
    <span class="muted">{loaded ? `${shown} ${shown === 1 ? 'pregunta' : 'preguntas'}` : ''}</span>
    {
      loaded && totalPages > 1 && (
        <nav class="pager" aria-label="Paginación">
          <a class="btn btn-xs btn-ghost" href={hrefWith({ page: page - 1 })} aria-disabled={page <= 1 ? 'true' : undefined} aria-label="Página anterior">←</a>
          <span class="muted">Página {page} de {totalPages}</span>
          <a class="btn btn-xs btn-ghost" href={hrefWith({ page: page + 1 })} aria-disabled={page >= totalPages ? 'true' : undefined} aria-label="Página siguiente">→</a>
        </nav>
      )
    }
  </div>

  <section class="list" aria-label="Consultas">
    {
      visible.map((q) => (
        <QuestionCard
          question={q}
          agentStatus={agentStatusOf(agentMap, q)}
          agent={agentMap.get(q.id)}
          connectionId={connectionId}
          returnTo={returnTo}
        />
      ))
    }
    {loaded && visible.length === 0 && <div class="card empty muted">No hay preguntas en esta pestaña.</div>}
    {
      loaded && totalPages > 1 && page < totalPages && (
        <a class="btn btn-outline more" href={hrefWith({ page: page + 1 })}>Página siguiente →</a>
      )
    }
  </section>
  </div>
</Layout>

<dialog class="detalle-modal" id="detalle-modal" aria-label="Detalle de la pregunta">
  <iframe title="Detalle de la pregunta" id="detalle-frame"></iframe>
  {/* Mientras carga el detalle (ML + historial tardan 1-2 s): la forma del chat, con la pregunta ya puesta. */}
  <div class="modal-loading" aria-hidden="true">
    <div class="sk-chat">
      <div class="sk-head">
        <button type="button" class="sk-close" data-cerrar-modal aria-label="Cerrar">✕</button>
        <span class="sk sk-line" style="width: 38%"></span>
      </div>
      <div class="sk-messages">
        <span class="sk sk-bubble left" style="width: 46%"></span>
        <span class="sk sk-bubble right" style="width: 58%; height: 64px"></span>
        <div class="sk-current"><span class="sk-label">Pregunta actual</span><p data-sk-pregunta></p></div>
        <span class="sk sk-bubble right" style="width: 52%; height: 52px"></span>
      </div>
      <div class="sk-composer"><span class="sk sk-line" style="width: 100%; height: 56px"></span></div>
    </div>
    <div class="sk-side">
      <span class="sk" style="width: 100%; aspect-ratio: 1.3"></span>
      <span class="sk sk-line" style="width: 80%"></span>
      <span class="sk sk-line" style="width: 40%; height: 18px"></span>
    </div>
    <span class="sr-only" role="status">Cargando la pregunta…</span>
  </div>
</dialog>

<script>
  // El detalle se abre en un modal sobre la lista (el mismo detalle, con
  // embed=1). Ctrl/Cmd/clic del medio sigue abriendo la página completa. En
  // captura: tiene que ganarle al listener del Layout que muestra "Cargando…".
  const modal = document.getElementById('detalle-modal') as HTMLDialogElement | null;
  const frame = document.getElementById('detalle-frame') as HTMLIFrameElement | null;
  let cambio = false;

  document.addEventListener(
    'click',
    (event) => {
      const link = event.target instanceof Element ? event.target.closest<HTMLAnchorElement>('a[data-detalle]') : null;
      if (!link || !modal || !frame) return;
      if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      event.stopPropagation();
      const url = new URL(link.href);
      url.searchParams.set('embed', '1');
      const pregunta = modal.querySelector<HTMLElement>('[data-sk-pregunta]');
      if (pregunta) pregunta.textContent = link.dataset.pregunta ?? '';
      modal.classList.add('cargando');
      frame.src = url.pathname + url.search;
      modal.showModal();
    },
    true,
  );

  const cerrar = () => modal?.open && modal.close();
  // El iframe avisa `load` también al vaciarlo (about:blank): solo cuenta la del detalle.
  frame?.addEventListener('load', () => {
    if (modal && frame.getAttribute('src') !== 'about:blank') modal.classList.remove('cargando');
  });
  modal?.querySelector('[data-cerrar-modal]')?.addEventListener('click', () => cerrar());
  // Clic en el fondo (fuera del iframe) cierra.
  modal?.addEventListener('click', (event) => {
    if (event.target === modal) cerrar();
  });
  modal?.addEventListener('close', () => {
    if (frame) frame.src = 'about:blank';
    modal?.classList.remove('cargando');
    // Si se aprobó o editó adentro, la lista (y los conteos) cambiaron.
    if (cambio) location.reload();
  });
  window.addEventListener('message', (event) => {
    if (event.origin !== location.origin) return;
    if (event.data?.type === 'detalle:cerrar') cerrar();
    if (event.data?.type === 'detalle:cambio') cambio = true;
  });

  // Cualquier cambio en fechas u orden filtra solo, y vuelve a la página 1
  // (el form no envía "page").
  document.querySelectorAll<HTMLInputElement | HTMLSelectElement>('form.controls select, form.controls input[type="date"]').forEach((el) =>
    el.addEventListener('change', () => el.form?.requestSubmit()),
  );
</script>

<style>
  .toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px 20px;
    flex-wrap: wrap;
    margin-bottom: 12px;
  }

  /* TabBar de Chatwoot (components-next/tabbar): un segmentado con la pestaña
     activa en una "pastilla". No `.tabs`: es una clase de daisyUI. */
  .state-tabs {
    display: flex;
    align-items: center;
    gap: 2px;
    height: 32px;
    padding: 0;
    border-radius: 8px;
    background: rgb(var(--alpha-1));
    overflow-x: auto;
    min-width: 0;
    scrollbar-width: none;
  }
  .state-tab {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    flex: none;
    height: 32px;
    padding: 0 14px;
    border-radius: 8px;
    color: var(--text-faint);
    font-size: 14px;
    font-weight: 400;
    text-decoration: none !important;
    transition: color 0.2s ease-out, background-color 0.2s ease-out;
  }
  .state-tab:hover { color: var(--brand); }
  .state-tab.active {
    background: rgb(var(--solid-active));
    color: var(--link);
    outline: 1px solid rgb(var(--border-container));
    outline-offset: -1px;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.06);
  }
  .tab-count {
    min-width: 18px;
    height: 18px;
    padding: 0 5px;
    border-radius: 6px;
    background: var(--revision-bg);
    color: var(--revision);
    font-size: 11px;
    font-weight: 600;
    line-height: 18px;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }

  .controls { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .controls label { display: flex; align-items: center; gap: 6px; font-size: 13px; color: var(--text-muted); }
  .controls input[type='date'] { width: 9.5rem; }
  .refresh { gap: 6px; }

  .note { font-size: 13px; margin: 0 0 10px; }
  .flash { margin: 0 0 12px; }

  .detalle-modal {
    width: min(1180px, calc(100vw - 48px));
    height: calc(100dvh - 48px);
    max-width: none;
    max-height: none;
    margin: auto;
    padding: 0;
    border: 0;
    border-radius: 12px;
    outline: 1px solid rgb(var(--border-container));
    background: var(--bg);
    box-shadow: 0 20px 60px rgb(0 0 0 / 0.25);
    overflow: hidden;
  }
  .detalle-modal::backdrop { background: rgb(var(--overlay)); }
  .detalle-modal iframe { display: block; width: 100%; height: 100%; border: 0; }

  /* Esqueleto del modal: encima del iframe hasta que el detalle carga. */
  .modal-loading { display: none; position: absolute; inset: 0; gap: 12px; padding: 12px; background: var(--bg); }
  .detalle-modal.cargando .modal-loading { display: grid; grid-template-columns: minmax(0, 1fr) 300px; }
  .sk-chat, .sk-side { display: flex; flex-direction: column; border: 1px solid var(--border); border-radius: 12px; background: var(--surface); overflow: hidden; }
  .sk-side { gap: 12px; padding: 16px; }
  .sk-head { display: flex; align-items: center; gap: 12px; height: 56px; padding: 0 16px; border-bottom: 1px solid var(--border); }
  .sk-close { border: 0; background: none; cursor: pointer; color: var(--text-muted); font-size: 16px; padding: 0 4px; }
  .sk-messages { flex: 1; display: flex; flex-direction: column; justify-content: flex-end; gap: 10px; padding: 16px; background: var(--bg); }
  .sk-composer { padding: 12px 16px; border-top: 1px solid var(--border); }
  .sk {
    display: block;
    border-radius: 8px;
    background: linear-gradient(90deg, rgb(var(--slate-3)) 0%, rgb(var(--slate-4)) 45%, rgb(var(--slate-3)) 100%);
    background-size: 200% 100%;
    animation: shimmer 1.15s ease-in-out infinite;
  }
  .sk-line { height: 14px; }
  .sk-bubble { height: 40px; border-radius: 12px; }
  .sk-bubble.right { align-self: flex-end; }
  .sk-current { align-self: flex-start; max-width: 78%; padding: 8px 12px; border-radius: 12px; border-top-left-radius: 4px; background: rgb(var(--slate-4)); outline: 2px solid var(--brand); }
  .sk-current p { margin: 0; font-size: 14px; line-height: 1.5; overflow-wrap: anywhere; }
  .sk-label { display: block; margin-bottom: 2px; font-size: 12px; font-weight: 500; color: var(--link); }
  @media (prefers-reduced-motion: reduce) { .sk { animation: none; } }
  @media (max-width: 900px) {
    .detalle-modal.cargando .modal-loading { grid-template-columns: 1fr; }
    .sk-side { display: none; }
  }
  .list-card {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--surface);
    overflow: hidden;
  }
  .results-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 44px;
    padding: 6px 16px;
    border-bottom: 1px solid rgb(var(--border-weak));
    font-size: 13px;
  }
  .list {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    display: flex;
    flex-direction: column;
    padding: 4px 8px;
  }
  .empty { margin: 8px; padding: 32px; text-align: center; border: 0; background: none; }
  .more { align-self: center; margin: 8px 0; }
  .pager { display: flex; align-items: center; gap: 6px; }

  @media (max-width: 900px) {
    .state-tabs { width: 100%; }
    .controls { width: 100%; }
  }
  @media (max-width: 640px) {
    .detalle-modal { width: 100vw; height: 100dvh; border-radius: 0; }
    .modal-loading { padding: 0; }
    .sk-chat { border: 0; border-radius: 0; }
    .controls label { flex: 1 1 calc(50% - 8px); flex-direction: column; align-items: stretch; gap: 4px; }
    .controls input[type='date'] { width: 100%; }
    .refresh { flex: none; width: 32px; padding: 0; align-self: flex-end; }
    .refresh-label { display: none; }
    .list { padding: 4px; }
  }
</style>
