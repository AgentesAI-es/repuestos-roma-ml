---
import Layout from '../layouts/Layout.astro';
import QuestionCard from '../components/QuestionCard.astro';
import { ApiError, getConnections, listQuestions } from '../lib/ml-api';
import { connectionName, resolveConnectionId } from '../lib/accounts';
import {
  AGENT_STATUSES,
  AGENT_STATUS_META,
  agentSource,
  agentStatusOf,
  getAgentResponses,
  isAgentStatus,
} from '../lib/agent-responses';
import { dayToIso } from '../lib/format';
import type { AgentStatus, Connection, QuestionsList } from '../lib/types';

const PAGE_SIZE = 50;
const params = Astro.url.searchParams;

const status = params.get('status') ?? 'UNANSWERED';
const sort = params.get('sort') === 'asc' ? 'asc' : 'desc';
const from = params.get('from') ?? '';
const to = params.get('to') ?? '';
const agentParam = params.get('agent');
const agentFilter: AgentStatus | null = isAgentStatus(agentParam) ? agentParam : null;
const page = Math.max(1, Number.parseInt(params.get('page') ?? '1', 10) || 1);

let connections: Connection[] = [];
let data: QuestionsList | null = null;
let error: string | null = null;
let loginUrl: string | null = null;
let connectionId: number | undefined;

try {
  const conn = await getConnections();
  connections = conn.connections;
  loginUrl = conn.login_url;

  connectionId = resolveConnectionId(connections, Number(params.get('connection')));

  if (connectionId) {
    data = await listQuestions({
      connection_id: connectionId,
      status: status === 'ALL' ? undefined : status,
      sort,
      from_date: dayToIso(from),
      to_date: dayToIso(to, true),
      offset: (page - 1) * PAGE_SIZE,
      limit: PAGE_SIZE,
    });
  }
} catch (err) {
  error = err instanceof ApiError ? err.message : 'Error inesperado al consultar la API.';
  if (err instanceof ApiError) {
    loginUrl = (err.body as { login_url?: string } | null)?.login_url ?? loginUrl;
  }
  console.error('[index]', err);
}

const questions = data?.questions ?? [];
const agentMap = await getAgentResponses(questions.map((q) => q.id));

const visible = agentFilter ? questions.filter((q) => agentStatusOf(agentMap, q) === agentFilter) : questions;

const total = data?.total ?? 0;
const totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE));
const selectedConnection = connections.find((c) => c.id === connectionId);

function hrefWith(changes: Record<string, string | number | null>) {
  const u = new URL(Astro.url);
  for (const [k, v] of Object.entries(changes)) {
    if (v === null || v === '') u.searchParams.delete(k);
    else u.searchParams.set(k, String(v));
  }
  return `${u.pathname}${u.search}`;
}

---

<Layout connectionId={connectionId}>
  <div class="head">
    <div>
      <span class="eyebrow">Bandeja de trabajo</span>
      <h1>Preguntas de clientes</h1>
      {selectedConnection && <div class="selected-account">Cuenta: <strong>{connectionName(selectedConnection)}</strong></div>}
      <p class="muted">
        {data ? `${total} preguntas para el estado de Mercado Libre seleccionado` : 'Revisá las consultas de Mercado Libre'}
        {agentSource() === 'none' && ' · revisión del agente disponible al conectar la API de repuestos'}
      </p>
    </div>
    <a href={Astro.url.pathname + Astro.url.search} class="btn btn-outline refresh" data-loading="Actualizando…" aria-label="Actualizar preguntas"><span aria-hidden="true">↻</span><span class="refresh-label">Actualizar</span></a>
  </div>

  {
    error && (
      <div class="alert alert-error" role="alert">
        <strong>No se pudieron cargar las preguntas.</strong> {error}
      </div>
    )
  }

  {
    !error && connections.length === 0 && (
      <div class="alert alert-info">
        No hay cuentas de Mercado Libre conectadas.
        {loginUrl && (
          <>
            {' '}Conectá una desde <a href={loginUrl} target="_blank" rel="noopener">{loginUrl}</a>.
          </>
        )}
      </div>
    )
  }

  <div class="section-label">Estado de la respuesta</div>
  <nav class="agent-filters" aria-label="Filtrar por estado del agente">
    <a href={hrefWith({ agent: null, page: null })} class:list={['state-tab', { active: !agentFilter }]} aria-current={!agentFilter ? 'page' : undefined}>
      Todos los estados
    </a>
    {
      AGENT_STATUSES.map((s) => (
        <a
          href={hrefWith({ agent: agentFilter === s ? null : s, page: null })}
          class:list={['state-tab', 'agent-btn', s, { active: agentFilter === s }]}
          title={AGENT_STATUS_META[s].hint}
          aria-current={agentFilter === s ? 'page' : undefined}
        >
          <span class="state-dot" aria-hidden="true"></span>{s === 'pendiente' ? 'Para revisar' : AGENT_STATUS_META[s].label}
        </a>
      ))
    }
  </nav>

  <form method="get" class="card filters">
    {/* La cuenta se elige en la grilla; acá solo se conserva al filtrar. */}
    {connectionId && <input type="hidden" name="connection" value={connectionId} />}
    {agentFilter && <input type="hidden" name="agent" value={agentFilter} />}

    <label class="status-filter">
      Estado en Mercado Libre
      <select name="status" class="select select-bordered">
        <option value="UNANSWERED" selected={status === 'UNANSWERED'}>Sin responder</option>
        <option value="ANSWERED" selected={status === 'ANSWERED'}>Respondidas</option>
        <option value="ALL" selected={status === 'ALL'}>Todas</option>
      </select>
    </label>

    <label>
      Desde
      <input type="date" name="from" value={from} class="input input-bordered" />
    </label>
    <label>
      Hasta
      <input type="date" name="to" value={to} class="input input-bordered" />
    </label>

    <label>
      Orden
      <select name="sort" class="select select-bordered">
        <option value="desc" selected={sort === 'desc'}>Más nuevas</option>
        <option value="asc" selected={sort === 'asc'}>Más viejas</option>
      </select>
    </label>

    <div class="filter-actions">
      <button type="submit" class="btn btn-primary" data-loading="Filtrando…">Filtrar</button>
      <a href={connectionId ? `/?connection=${connectionId}` : "/"} class="btn btn-ghost">Limpiar</a>
    </div>
  </form>

  {
    (from || to || agentFilter) && data && (
      <p class="muted note">
        El filtro del agente se aplica sobre la página actual ({questions.length} de {total}).
      </p>
    )
  }

  <div class="results-head">
    <div><h2>Consultas</h2><span class="muted">{visible.length} en esta página</span></div>
    {data && <span class="page-position muted">Página {page} de {totalPages}</span>}
  </div>

  <section class="list" aria-label="Consultas">
    {
      visible.map((q) => (
        <QuestionCard
          question={q}
          agentStatus={agentStatusOf(agentMap, q)}
          agent={agentMap.get(q.id)}
          connectionId={connectionId}
        />
      ))
    }
    {data && visible.length === 0 && <div class="card empty muted">No hay preguntas para estos filtros.</div>}
  </section>

  {
    data && totalPages > 1 && (
      <nav class="pager" aria-label="Paginación">
        <a class="btn btn-outline" href={hrefWith({ page: page - 1 })} aria-disabled={page <= 1 ? 'true' : undefined}>
          ← Anterior
        </a>
        <span class="muted">
          Página {page} de {totalPages}
        </span>
        <a class="btn btn-outline" href={hrefWith({ page: page + 1 })} aria-disabled={page >= totalPages ? 'true' : undefined}>
          Siguiente →
        </a>
      </nav>
    )
  }
</Layout>

<script>
  // Al cambiar un filtro se vuelve a la página 1 (el form no envía "page").
  document.querySelectorAll<HTMLSelectElement>('form.filters select').forEach((el) =>
    el.addEventListener('change', () => el.form?.requestSubmit()),
  );
</script>

<style>
  .head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 12px;
    margin-bottom: 28px;
  }
  .eyebrow { display: block; margin-bottom: 6px; color: var(--link); font-size: 11px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }
  h1 { margin: 0; font-size: clamp(25px, 3vw, 32px); line-height: 1.2; letter-spacing: -.03em; font-weight: 750; }
  .selected-account { margin-top: 7px; color: var(--text-muted); font-size: 14px; }
  .selected-account strong { color: var(--text); }
  .head p { margin: 7px 0 0; font-size: 14px; }
  .refresh { background: var(--surface); }
  .section-label { margin-bottom: 9px; color: var(--text-muted); font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; }

  .agent-filters {
    display: flex;
    gap: 4px;
    margin-bottom: 18px;
    border-bottom: 1px solid var(--border);
    overflow-x: auto;
  }
  .state-tab {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    flex: none;
    padding: 10px 16px;
    border-bottom: 3px solid transparent;
    color: var(--text-muted);
    font-size: 14px;
    font-weight: 650;
    text-decoration: none !important;
  }
  .state-tab:hover { color: var(--text); background: var(--surface); }
  .state-tab.active { border-bottom-color: var(--brand); color: var(--brand); }
  .state-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--sin); }
  .pendiente .state-dot { background: var(--revision); }
  .respondida .state-dot { background: var(--si); }

  .filters {
    display: grid;
    grid-template-columns: minmax(170px, 1.3fr) repeat(3, minmax(140px, 1fr)) auto;
    gap: 12px;
    align-items: end;
    padding: 16px;
    margin-bottom: 24px;
  }
  .filters label {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 11px;
    font-weight: 600;
    color: var(--text-muted);
  }
  .filters select, .filters input { width: 100%; min-width: 0; font-size: 13px; background: var(--surface); }
  .filter-actions { display: flex; gap: 6px; white-space: nowrap; }
  .note { font-size: 13px; margin: 0 0 10px; }

  .results-head { display: flex; align-items: end; justify-content: space-between; margin: 0 0 12px; }
  .results-head > div { display: flex; align-items: baseline; gap: 10px; }
  .results-head h2 { margin: 0; font-size: 18px; font-weight: 750; }
  .results-head span { font-size: 13px; }
  .list { display: flex; flex-direction: column; gap: 8px; }
  .empty { padding: 32px; text-align: center; }

  .pager {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 16px;
    margin-top: 20px;
  }

  @media (max-width: 1000px) { .filters { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) {
    .head { align-items: flex-start; }
    .refresh { flex: none; width: 38px; padding: 0; font-size: 20px; }
    .refresh-label { display: none; }
    .filters { gap: 10px; padding: 12px; }
    .filters .status-filter, .filter-actions { grid-column: 1 / -1; }
    .filter-actions .btn { flex: 1; }
    .page-position { display: none; }
  }
</style>
