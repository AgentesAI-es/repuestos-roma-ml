---
import Layout from '../../layouts/Layout.astro';
import AgentBadge from '../../components/AgentBadge.astro';
import PublicationPanel from '../../components/PublicationPanel.astro';
import { ApiError, getBuyerHistory, getConnections, getQuestion } from '../../lib/ml-api';
import { connectionName } from '../../lib/accounts';
import { agentStatusOf, getAgentResponses, type AgentResponseMap } from '../../lib/agent-responses';
import { formatDate } from '../../lib/format';
import type { Question, QuestionDetailResponse } from '../../lib/types';

/**
 * El detalle es una conversación: las preguntas anteriores del comprador en
 * esta publicación, la actual, su respuesta (la publicada en ML y/o la del
 * agente) y, si la del agente está pendiente, el cuadro para resolverla.
 * Todo en una card del alto de la pantalla; solo la conversación scrollea.
 */
const { id = '' } = Astro.params;
if (!/^\d+$/.test(id)) return Astro.redirect('/');

const connectionParam = Number(Astro.url.searchParams.get('connection')) || undefined;
// Dentro del modal de la bandeja: sin barra ni márgenes, y "cerrar" en vez de "volver".
const embed = Astro.url.searchParams.get('embed') === '1';

let detail: QuestionDetailResponse | null = null;
let error: string | null = null;
try {
  detail = await getQuestion(id, connectionParam);
} catch (err) {
  error = err instanceof ApiError ? err.message : 'Error inesperado al consultar la API.';
  if (err instanceof ApiError && err.status === 404) Astro.response.status = 404;
  console.error('[pregunta]', err);
}

const q = detail?.question;
const connection = detail?.connection_id ?? connectionParam;

// El historial y la respuesta del agente no dependen uno del otro. Un fallo
// en cualquiera no rompe el detalle.
const [historyResult, agentResult, connectionsResult] = await Promise.allSettled([
  q && connection ? getBuyerHistory(connection, q) : Promise.resolve([] as Question[]),
  q ? getAgentResponses([q.id]) : Promise.resolve(new Map() as AgentResponseMap),
  getConnections(),
]);
const history = historyResult.status === 'fulfilled' ? historyResult.value : null;
if (historyResult.status === 'rejected') console.error('[pregunta] historial', historyResult.reason);
const agentMap: AgentResponseMap = agentResult.status === 'fulfilled' ? agentResult.value : new Map();
const agent = q ? agentMap.get(q.id) : undefined;
const agentStatus = q ? agentStatusOf(agentMap, q) : 'sin_responder';
const account =
  connectionsResult.status === 'fulfilled'
    ? connectionsResult.value.connections.find((c) => c.id === connection)
    : undefined;

// Resultado de resolver (vuelve de /api/revision).
const revisionOk = Astro.url.searchParams.get('revision');
const revisionError = Astro.url.searchParams.get('revision_error');

const backHref = connection ? `/?connection=${connection}` : '/';
const fullHref = `/preguntas/${id}${connection ? `?connection=${connection}` : ''}`;

/** "23/09/26" para separar la conversación por día. */
const dayOf = (iso: string | null | undefined) => (iso ? formatDate(iso).split(',')[0] : '');
const hourOf = (iso: string | null | undefined) => (iso ? formatDate(iso).split(', ')[1] ?? '' : '');
const days = [...(history ?? []), ...(q ? [q] : [])].map((m) => dayOf(m.date_created));
---

<Layout title={q ? `Pregunta ${q.id}` : 'Pregunta'} connectionId={connection} accounts={false} fill bare={embed}>
  {error && (
    <>
      {embed ? <button type="button" class="btn btn-sm btn-ghost" data-close>Cerrar</button> : <a href={backHref} class="back">← Bandeja</a>}
      <div class="alert alert-error" role="alert"><strong>No se pudo cargar la pregunta.</strong> {error}</div>
    </>
  )}

  {
    q && (
      <div class:list={['shell', { embed }]}>
        <section class="card chat" aria-label="Conversación">
          <header class="chat-head">
            {embed ? (
              <button type="button" class="back close" data-close aria-label="Cerrar">✕</button>
            ) : (
              <a href={backHref} class="back" aria-label="Volver a la bandeja">←<span class="back-label"> Bandeja</span></a>
            )}
            <h1>
              <span class="buyer">{q.from?.nickname ?? 'Comprador'}</span>
              <span class="muted head-meta">
                {account && <> · {connectionName(account)}</>} · #{q.id}
              </span>
            </h1>
            <AgentBadge status={agentStatus} />
            {embed && <a href={fullHref} target="_top" class="open-full" title="Abrir en página completa" aria-label="Abrir en página completa">↗</a>}
          </header>

          <details class="pub-strip">
            <summary>
              {detail?.item?.secure_thumbnail || detail?.publication?.thumbnail ? (
                <img src={detail?.item?.secure_thumbnail ?? detail?.publication?.thumbnail} alt="" />
              ) : null}
              <span class="strip-title">{detail?.item?.title ?? detail?.publication?.title ?? q.item_id}</span>
              <span class="strip-more muted">Ver publicación</span>
            </summary>
            <PublicationPanel item={detail?.item} pub={detail?.publication} itemId={q.item_id} />
          </details>

          <div class="messages" id="messages">
            {history === null && <p class="system">No se pudo cargar el historial del comprador en esta publicación.</p>}
            {history?.length === 0 && <p class="system">Es la primera pregunta de este comprador en esta publicación.</p>}

            {(history ?? []).map((h, i) => (
              <>
                {days[i] !== days[i - 1] && <p class="day">{days[i]}</p>}
                <div class="msg buyer-msg">
                  <p>{h.text}</p>
                  <span class="time">{hourOf(h.date_created)}</span>
                </div>
                {h.answer?.text && (
                  <div class="msg seller-msg">
                    <span class="who">Vendedor</span>
                    <p>{h.answer.text}</p>
                    <span class="time">{hourOf(h.answer.date_created)}</span>
                  </div>
                )}
              </>
            ))}

            {days.at(-1) !== days.at(-2) && <p class="day">{days.at(-1)}</p>}
            <div class="msg buyer-msg current">
              <span class="who">Pregunta actual</span>
              <p>{q.text}</p>
              <span class="time">{hourOf(q.date_created)}</span>
            </div>

            {q.answer?.text && (
              <div class="msg seller-msg">
                <span class="who">Publicada en Mercado Libre</span>
                <p>{q.answer.text}</p>
                <span class="time">{formatDate(q.answer.date_created)}</span>
              </div>
            )}

            {agent?.status === 'pendiente' && (
              <div class="msg seller-msg agent pendiente">
                <span class="who">⏳ Propuesta del agente</span>
                <p>{agent.respuestaPropuesta}</p>
                <span class="time">{formatDate(agent.creadoEn)}</span>
              </div>
            )}
            {agent?.status === 'aprobado' && (
              <div class="msg seller-msg agent resuelta">
                <span class="who">✓ Aprobada{agent.revisadoPor && ` por ${agent.revisadoPor}`}</span>
                <p>{agent.respuestaEnviada ?? agent.respuestaPropuesta}</p>
                <span class="time">{formatDate(agent.revisadoEn)}</span>
              </div>
            )}
            {agent?.status === 'editado' && (
              <div class="msg seller-msg agent resuelta">
                <span class="who">✏️ Editada{agent.revisadoPor && ` por ${agent.revisadoPor}`}</span>
                <p>{agent.respuestaEnviada}</p>
                <details class="original">
                  <summary>Propuesta original del agente</summary>
                  <p>{agent.respuestaPropuesta}</p>
                </details>
                <span class="time">{formatDate(agent.revisadoEn)}</span>
              </div>
            )}

            {revisionOk && (
              <p class="system ok" role="status">
                {revisionOk === 'editado'
                  ? 'Respuesta editada. Quedó una nota privada en Chatwoot con el texto corregido.'
                  : 'Respuesta aprobada.'}
              </p>
            )}
          </div>

          {agent?.status === 'pendiente' && (
            <form method="post" action="/api/revision" class="composer" data-original={agent.respuestaPropuesta}>
              {revisionError && (
                <p class="composer-error" role="alert"><strong>No se pudo guardar.</strong> {revisionError}</p>
              )}
              <input type="hidden" name="id" value={agent.id} />
              <input type="hidden" name="question_id" value={q.id} />
              {connection && <input type="hidden" name="connection" value={connection} />}
              {embed && <input type="hidden" name="embed" value="1" />}
              <label class="sr-only" for="respuesta">Respuesta que se va a enviar</label>
              <textarea id="respuesta" name="respuesta" class="textarea" rows="3" maxlength="2000" required>{agent.respuestaPropuesta}</textarea>
              <div class="composer-foot">
                <span class="muted composer-hint" data-hint>
                  Si no la tocás, se aprueba tal cual. No publica nada en Mercado Libre.
                </span>
                <button class="btn btn-primary" type="submit" data-submit data-loading="Guardando…">Aprobar</button>
              </div>
            </form>
          )}
        </section>

        <aside class="card side">
          <PublicationPanel item={detail?.item} pub={detail?.publication} itemId={q.item_id} />
        </aside>
      </div>
    )
  }
</Layout>

<script>
  // En el modal: cerrar, y avisarle a la bandeja que algo cambió para que se
  // recargue al cerrar.
  if (window.parent !== window) {
    const avisar = (type: string) => window.parent.postMessage({ type }, location.origin);
    document.querySelectorAll('[data-close]').forEach((b) => b.addEventListener('click', () => avisar('detalle:cerrar')));
    if (new URLSearchParams(location.search).get('revision')) avisar('detalle:cambio');
  }

  // Como un chat: arranca abajo, en la pregunta actual.
  const messages = document.getElementById('messages');
  if (messages) messages.scrollTop = messages.scrollHeight;

  // El botón dice lo que va a pasar: sin cambios se aprueba; con cambios, se
  // envía editada (la API decide igual, esto es solo el texto).
  const form = document.querySelector<HTMLFormElement>('form.composer');
  const textarea = form?.querySelector('textarea');
  const submit = form?.querySelector<HTMLButtonElement>('[data-submit]');
  const hint = form?.querySelector<HTMLElement>('[data-hint]');
  if (form && textarea && submit && hint) {
    const original = (form.dataset.original ?? '').trim();
    const autosize = () => {
      textarea.style.height = 'auto';
      textarea.style.height = `${Math.min(textarea.scrollHeight + 2, 220)}px`;
    };
    const update = () => {
      const edited = textarea.value.trim() !== original;
      submit.textContent = edited ? 'Enviar editada' : 'Aprobar';
      hint.textContent = edited
        ? 'Queda como editada y deja una nota privada en Chatwoot con este texto.'
        : 'Si no la tocás, se aprueba tal cual. No publica nada en Mercado Libre.';
      autosize();
    };
    textarea.addEventListener('input', update);
    update();
  }
</script>

<style>
  .shell {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 16px;
    /* Topbar (68) + aire de main (30). */
    height: calc(100dvh - 98px);
    min-height: 460px;
  }

  .shell.embed { height: 100dvh; min-height: 0; padding: 12px; gap: 12px; }
  .close { border: 0; background: none; cursor: pointer; color: var(--text-muted); font-size: 18px; padding: 0 4px; }
  .close:hover { color: var(--text); }
  .open-full { flex: none; font-size: 16px; color: var(--text-muted); text-decoration: none !important; }
  .open-full:hover { color: var(--link); }
  .chat { display: flex; flex-direction: column; min-height: 0; overflow: hidden; padding: 0; }
  .chat-head {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 18px;
    border-bottom: 1px solid var(--border);
  }
  .back { flex: none; font-size: 14px; font-weight: 600; }
  h1 { flex: 1; min-width: 0; margin: 0; font-size: 16px; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .head-meta { font-weight: 500; font-size: 14px; }

  .pub-strip { display: none; border-bottom: 1px solid var(--border); }
  .pub-strip summary {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 18px;
    cursor: pointer;
    list-style: none;
    font-size: 13px;
  }
  .pub-strip summary::-webkit-details-marker { display: none; }
  .pub-strip summary img { width: 34px; height: 34px; object-fit: contain; background: #fff; border-radius: 6px; flex: none; }
  .strip-title { flex: 1; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-weight: 600; }
  .strip-more { flex: none; font-size: 12px; }
  .pub-strip[open] .strip-more { visibility: hidden; }
  .pub-strip > :global(.pub) { padding: 4px 18px 14px; max-height: 45dvh; overflow-y: auto; }
  .pub-strip :global(.pub img) { max-width: 200px; }

  .messages {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 16px 18px;
    background: var(--bg);
    overscroll-behavior: contain;
  }
  /* Con pocos mensajes, la conversación va pegada abajo (como un chat y como el esqueleto del modal). */
  .messages > :first-child { margin-top: auto; }
  .day, .system { align-self: center; margin: 6px 0; font-size: 12px; color: var(--text-muted); text-align: center; }
  .day { padding: 2px 10px; border-radius: 999px; background: var(--surface); border: 1px solid var(--border); }
  .system.ok { color: var(--si); font-weight: 600; }

  .msg {
    max-width: min(78%, 620px);
    padding: 8px 12px 6px;
    border-radius: 12px;
    font-size: 15px;
    line-height: 1.45;
    overflow-wrap: anywhere;
    border: 1px solid var(--border);
  }
  .msg p { margin: 0; white-space: pre-wrap; }
  .who { display: block; margin-bottom: 2px; font-size: 11px; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: .04em; }
  .time { display: block; margin-top: 3px; font-size: 11px; color: var(--text-muted); text-align: right; }
  .buyer-msg { align-self: flex-start; background: var(--surface); border-bottom-left-radius: 4px; }
  .buyer-msg.current { border-color: var(--link); box-shadow: 0 0 0 1px var(--link); }
  .buyer-msg.current .who { color: var(--link); }
  .seller-msg { align-self: flex-end; background: var(--sin-revision-bg); border-bottom-right-radius: 4px; }
  .agent.pendiente { background: var(--revision-bg); border-color: var(--revision); border-style: dashed; }
  .agent.pendiente .who { color: var(--revision); }
  .agent.resuelta .who { color: var(--si); }
  .original { margin-top: 6px; font-size: 13px; color: var(--text-muted); }
  .original summary { cursor: pointer; font-size: 12px; }
  .original p { margin-top: 4px; text-decoration: line-through; }

  .composer { display: flex; flex-direction: column; gap: 8px; padding: 12px 18px 14px; border-top: 1px solid var(--border); background: var(--surface); }
  .composer textarea { width: 100%; min-height: 64px; font-size: 15px; line-height: 1.45; resize: none; background: var(--surface); }
  .composer-foot { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .composer-hint { font-size: 12px; }
  .composer-error { margin: 0; font-size: 13px; color: var(--no); }

  .side { overflow-y: auto; padding: 18px; }

  @media (max-width: 900px) {
    .shell { grid-template-columns: 1fr; }
    .side { display: none; }
    .pub-strip { display: block; }
  }
  @media (max-width: 640px) {
    .shell.embed { padding: 0; }
    .shell.embed .chat { border-radius: 0; border: 0; }
    .chat-head { padding: 10px 12px; gap: 8px; }
    .back-label, .head-meta { display: none; }
    .messages { padding: 12px; }
    .msg { max-width: 88%; font-size: 14px; }
    .composer { padding: 10px 12px 12px; }
    .composer-foot { flex-direction: column; align-items: stretch; }
    .composer-foot .btn { width: 100%; }
  }
</style>
