---
import Layout from '../../layouts/Layout.astro';
import AgentBadge from '../../components/AgentBadge.astro';
import { ApiError, getQuestion } from '../../lib/ml-api';
import {
  AGENT_STATUS_META,
  REVISION_LABEL,
  agentSource,
  agentStatusOf,
  getAgentResponses,
  type AgentResponseMap,
} from '../../lib/agent-responses';
import { formatDate, formatPrice, ML_STATUS_LABEL } from '../../lib/format';
import type { QuestionDetailResponse } from '../../lib/types';

const { id = '' } = Astro.params;
if (!/^\d+$/.test(id)) return Astro.redirect('/');

const connectionParam = Number(Astro.url.searchParams.get('connection')) || undefined;

let detail: QuestionDetailResponse | null = null;
let error: string | null = null;
try {
  detail = await getQuestion(id, connectionParam);
} catch (err) {
  error = err instanceof ApiError ? err.message : 'Error inesperado al consultar la API.';
  if (err instanceof ApiError && err.status === 404) Astro.response.status = 404;
  console.error('[pregunta]', err);
}

const q = detail?.question;
const item = detail?.item;
const pub = detail?.publication;
const agentMap: AgentResponseMap = q ? await getAgentResponses([q.id]) : new Map();
const agent = q ? agentMap.get(q.id) : undefined;
const agentStatus = q ? agentStatusOf(agentMap, q) : 'sin_responder';

// Resultado de aprobar/editar (vuelve de /api/revision).
const revisionOk = Astro.url.searchParams.get('revision');
const revisionError = Astro.url.searchParams.get('revision_error');

const image = item?.pictures?.[0]?.secure_url ?? item?.secure_thumbnail ?? pub?.thumbnail ?? null;
const attributes = (item?.attributes ?? []).filter((a) => a.value_name);
const backHref = connectionParam ? `/?connection=${connectionParam}` : '/';
---

<Layout title={q ? `Pregunta ${q.id}` : 'Pregunta'} connectionId={connectionParam}>
  <a href={backHref} class="back">← Volver a la bandeja</a>

  {q && <div class="page-head"><span class="eyebrow">Detalle de consulta</span><h1>Pregunta #{q.id}</h1><p class="muted">Revisá el contexto y resolvé la respuesta del agente.</p></div>}

  {error && <div class="alert alert-error" role="alert"><strong>No se pudo cargar la pregunta.</strong> {error}</div>}

  {
    q && (
      <div class="grid">
        <div class="main">
          <section class="card block">
            <div class="meta muted">
              <span class:list={['ml-status', { answered: q.status === 'ANSWERED' }]}>
                {ML_STATUS_LABEL[q.status] ?? q.status}
              </span>
              <span>· {formatDate(q.date_created)}</span>
              {q.from?.nickname && <span>· {q.from.nickname}</span>}
              <span>· #{q.id}</span>
            </div>
            <h2 class="question">{q.text}</h2>

            {q.answer?.text ? (
              <div class="answer">
                <div class="label">Respuesta publicada en ML · {formatDate(q.answer.date_created)}</div>
                <p>{q.answer.text}</p>
              </div>
            ) : (
              <p class="muted">Todavía no tiene respuesta publicada en Mercado Libre.</p>
            )}
          </section>

          <section class:list={['card', 'block', 'agent', agentStatus]}>
            <div class="agent-head">
              <div><span class="eyebrow">Acción principal</span><h2>Respuesta propuesta</h2></div>
              <AgentBadge status={agentStatus} size="md" />
            </div>
            <p class="muted hint">{AGENT_STATUS_META[agentStatus].hint}.</p>

            {revisionOk && (
              <div class="alert alert-info" role="status">
                {revisionOk === 'editado'
                  ? 'Respuesta editada. Quedó una nota privada en Chatwoot con el texto corregido.'
                  : 'Respuesta aprobada.'}
              </div>
            )}
            {revisionError && (
              <div class="alert alert-error" role="alert">
                <strong>No se pudo guardar la decisión.</strong> {revisionError}
              </div>
            )}

            {agent ? (
              <>
                {agent.status === 'editado' ? (
                  <>
                    <span class="label">Enviada (editada)</span>
                    <blockquote>{agent.respuestaEnviada}</blockquote>
                    <details class="original">
                      <summary>Ver la propuesta original del agente</summary>
                      <blockquote class="tachada">{agent.respuestaPropuesta}</blockquote>
                    </details>
                  </>
                ) : (
                  <blockquote>{agent.respuestaEnviada ?? agent.respuestaPropuesta}</blockquote>
                )}
                {agent.status === 'pendiente' ? (
                  <div class="hitl">
                    <form method="post" action="/api/revision">
                      <input type="hidden" name="id" value={agent.id} />
                      <input type="hidden" name="question_id" value={q.id} />
                      {connectionParam && <input type="hidden" name="connection" value={connectionParam} />}
                      <button class="btn btn-primary" type="submit" name="accion" value="aprobar" data-loading="Aprobando…">
                        Aprobar tal cual
                      </button>
                    </form>
                    <details class="editar">
                      <summary class="btn btn-outline">Editar respuesta</summary>
                      <form method="post" action="/api/revision">
                        <input type="hidden" name="id" value={agent.id} />
                        <input type="hidden" name="question_id" value={q.id} />
                        {connectionParam && <input type="hidden" name="connection" value={connectionParam} />}
                        <label class="label" for="respuesta-editada">Texto que se va a enviar</label>
                        <textarea id="respuesta-editada" class="textarea" name="respuesta" rows="5" maxlength="2000" required>{agent.respuestaPropuesta}</textarea>
                        <button class="btn btn-primary" type="submit" name="accion" value="editar" data-loading="Guardando…">
                          Guardar edición
                        </button>
                      </form>
                    </details>
                    <p class="muted decision-note">La decisión se registra internamente y no publica nada en Mercado Libre. Si editás, queda una nota privada en Chatwoot con el texto corregido.</p>
                  </div>
                ) : (
                  <p class:list={['decision', agent.status]}>
                    {REVISION_LABEL[agent.status][0].toUpperCase() + REVISION_LABEL[agent.status].slice(1)}
                    {agent.revisadoPor && ` por ${agent.revisadoPor}`}
                    {agent.revisadoEn && ` · ${formatDate(agent.revisadoEn)}`}
                  </p>
                )}
              </>
            ) : (
              <p class="muted">
                {agentSource() === 'none'
                  ? 'La API de repuestos no está conectada (falta REPUESTOS_API_URL).'
                  : 'No hay respuesta del agente pendiente de revisión para esta pregunta.'}
              </p>
            )}
          </section>
        </div>

        <aside class="card block item">
          <h2>Publicación</h2>
          {image && <img src={image} alt={item?.title ?? pub?.title ?? ''} />}
          <h3>
            {item?.permalink || pub?.permalink ? (
              <a href={item?.permalink ?? pub?.permalink} target="_blank" rel="noopener">
                {item?.title ?? pub?.title ?? q.item_id}
              </a>
            ) : (
              (item?.title ?? pub?.title ?? q.item_id)
            )}
          </h3>
          <p class="price">{formatPrice(item?.price ?? pub?.price, item?.currency_id ?? pub?.currency_id)}</p>
          <dl class="facts">
            {item?.available_quantity != null && (
              <>
                <dt>Stock</dt>
                <dd>{item.available_quantity}</dd>
              </>
            )}
            {item?.sold_quantity != null && (
              <>
                <dt>Vendidos</dt>
                <dd>{item.sold_quantity}</dd>
              </>
            )}
            {item?.condition && (
              <>
                <dt>Condición</dt>
                <dd>{item.condition === 'new' ? 'Nuevo' : item.condition === 'used' ? 'Usado' : item.condition}</dd>
              </>
            )}
            {(item?.status ?? pub?.status) && (
              <>
                <dt>Estado</dt>
                <dd>{item?.status ?? pub?.status}</dd>
              </>
            )}
          </dl>

          {attributes.length > 0 && (
            <details open={attributes.length <= 12}>
              <summary>Características ({attributes.length})</summary>
              <dl class="facts attrs">
                {attributes.map((a) => (
                  <>
                    <dt>{a.name}</dt>
                    <dd>{a.value_name}</dd>
                  </>
                ))}
              </dl>
            </details>
          )}
        </aside>
      </div>
    )
  }
</Layout>

<style>
  .back { display: inline-block; margin-bottom: 14px; }
  .page-head { margin: 2px 0 24px; }
  .eyebrow { display: block; margin-bottom: 6px; color: var(--link); font-size: 11px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }
  .page-head h1 { margin: 0; font-size: clamp(25px, 3vw, 32px); line-height: 1.2; letter-spacing: -.03em; }
  .page-head p { margin: 6px 0 0; font-size: 14px; }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 310px;
    gap: 20px;
    align-items: start;
  }
  .main { display: flex; flex-direction: column; gap: 16px; min-width: 0; }
  .block { padding: 24px; }
  .meta { display: flex; flex-wrap: wrap; gap: 6px; font-size: 13px; }
  .ml-status { font-weight: 700; text-transform: uppercase; font-size: 12px; color: var(--revision); }
  .ml-status.answered { color: var(--si); }
  .question { font-size: clamp(19px, 2vw, 24px); line-height: 1.4; margin: 12px 0 18px; overflow-wrap: anywhere; }
  .answer {
    border-left: 3px solid var(--si);
    background: var(--surface-2);
    padding: 10px 14px;
    border-radius: 0 8px 8px 0;
  }
  .answer p { margin: 4px 0 0; }
  .label { font-size: 12px; font-weight: 600; color: var(--text-muted); }

  .agent { order: -1; border-top: 4px solid var(--c, var(--sin)); }
  .agent.pendiente { --c: var(--revision); }
  .agent.respondida { --c: var(--sin-revision); }
  .decision { font-size: 14px; font-weight: 600; margin: 0; }
  .decision.aprobado { color: var(--si); }
  .decision.editado { color: var(--si); }
  .alert { margin: 0 0 12px; }
  .agent-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; }
  h2 { margin: 0; font-size: 19px; }
  .hint { margin: 7px 0 17px; font-size: 13px; }
  blockquote {
    margin: 0;
    padding: 18px 20px;
    background: var(--surface-2);
    border-radius: 10px;
    border-left: 3px solid var(--c, var(--sin));
    font-size: 17px;
    line-height: 1.6;
    overflow-wrap: anywhere;
  }
  dl { display: grid; grid-template-columns: max-content 1fr; gap: 6px 14px; margin: 0; font-size: 14px; }
  dt { color: var(--text-muted); }
  dd { margin: 0; overflow-wrap: anywhere; }
  .hitl { display: flex; flex-wrap: wrap; gap: 10px; align-items: flex-start; margin-top: 18px; padding-top: 18px; border-top: 1px solid var(--border); font-size: 13px; }
  .hitl form { margin: 0; }
  .editar { margin: 0; }
  .editar summary { list-style: none; margin: 0; }
  .editar summary::-webkit-details-marker { display: none; }
  .editar[open] { flex-basis: 100%; order: 1; }
  .editar[open] summary { display: none; }
  .editar form { display: flex; flex-direction: column; gap: 8px; }
  .editar textarea { width: 100%; font-size: 15px; line-height: 1.5; }
  .editar .btn { align-self: flex-start; }
  .original { margin-top: 10px; font-size: 13px; }
  .tachada { font-size: 14px; color: var(--text-muted); border-left-color: var(--border); }
  .decision { margin-top: 14px; }
  .decision-note { flex-basis: 100%; order: 2; margin: 2px 0 0; font-size: 12px; }
  .hitl .btn[disabled] { opacity: 0.5; cursor: not-allowed; }

  .item img {
    width: 100%;
    aspect-ratio: 1.3;
    object-fit: contain;
    background-color: #fff;
    border-radius: 8px;
    margin: 12px 0;
  }
  .item h3 { font-size: 15px; margin: 0 0 4px; line-height: 1.4; }
  .price { font-size: 22px; font-weight: 700; margin: 0 0 12px; }
  details { margin-top: 14px; }
  summary { cursor: pointer; font-weight: 600; margin-bottom: 8px; }
  .attrs { font-size: 13px; }

  @media (max-width: 860px) {
    .grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .block { padding: 18px; }
    .agent-head { flex-wrap: wrap; }
    blockquote { font-size: 15px; padding: 14px; }
    .hitl .btn { flex: 1; }
  }
</style>
